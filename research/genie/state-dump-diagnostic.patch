index d2edcddb..4ee72526 100644
--- a/crates/engine/genie-core/src/commands/mod.rs
+++ b/crates/engine/genie-core/src/commands/mod.rs
@@ -290,13 +290,28 @@ impl World {
         units
             .iter()
             .map(|&id| match self.place(id) {
+                Some(p) if p.player() == player => id,
+                _ => experiment_remap(id),
+            })
+            .map(|id| match self.place(id) {
                 Some(p)
                     if p.player() == player
                         || self.settings.flags.contains(OptionFlags::CHEATS_ENABLED) =>
                 {
                     id
                 }
-                _ => None,
+                other => {
+                    if std::env::var_os("GENIE_LOG_DROPPED").is_some() {
+                        eprintln!(
+                            "DROPPED world_ms={} player={} id={:?} holder={:?}",
+                            self.world_time.millis(),
+                            player.index(),
+                            id.map(ObjectId::get),
+                            other.map(|p| p.player().index())
+                        );
+                    }
+                    None
+                }
             })
             .collect()
     }
@@ -350,3 +365,25 @@ impl World {
         }
     }
 }
+
+/// Diagnostic only (`GENIE_EXPERIMENT_REMAP_IDS="from:to,..."`): a recorded unit id the
+/// simulation allocated to a different object is read as the id the simulation gave the unit,
+/// unless the commanding player holds the recorded id.
+fn experiment_remap(id: Option<ObjectId>) -> Option<ObjectId> {
+    static MAP: std::sync::OnceLock<Vec<(i32, i32)>> = std::sync::OnceLock::new();
+    let map = MAP.get_or_init(|| {
+        std::env::var("GENIE_EXPERIMENT_REMAP_IDS")
+            .unwrap_or_default()
+            .split(',')
+            .filter_map(|pair| {
+                let (a, b) = pair.split_once(':')?;
+                Some((a.trim().parse().ok()?, b.trim().parse().ok()?))
+            })
+            .collect()
+    });
+    let id = id?;
+    map.iter()
+        .find(|(from, _)| *from == id.get())
+        .and_then(|&(_, to)| ObjectId::of_field(to))
+        .or(Some(id))
+}
