+
+/// Diagnostic only (`GENIE_EXPERIMENT_REMAP_IDS="from:to,..."`): a recorded unit id the
+/// simulation allocated to a different object is read as the id the simulation gave the unit,
+/// unless the commanding player holds the recorded id.
+fn experiment_remap(id: Option<ObjectId>) -> Option<ObjectId> {
+    static MAP: std::sync::OnceLock<Vec<(i32, i32)>> = std::sync::OnceLock::new();
+    let map = MAP.get_or_init(|| {
+        std::env::var("GENIE_EXPERIMENT_REMAP_IDS")
+            .unwrap_or_default()
+            .split(',')
+            .filter_map(|pair| {
+                let (a, b) = pair.split_once(':')?;
+                Some((a.trim().parse().ok()?, b.trim().parse().ok()?))
+            })
+            .collect()
+    });
+    let id = id?;
+    map.iter()
+        .find(|(from, _)| *from == id.get())
+        .and_then(|&(_, to)| ObjectId::of_field(to))
+        .or(Some(id))
+}
