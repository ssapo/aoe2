diff --git a/crates/formats/genie-save/src/lib.rs b/crates/formats/genie-save/src/lib.rs
index 83eaaa03..6afa46d8 100644
--- a/crates/formats/genie-save/src/lib.rs
+++ b/crates/formats/genie-save/src/lib.rs
@@ -126,6 +126,50 @@ impl Header {
         self.file_header.new_save_game_version
     }
 
+    /// Save 68.9 writes each player's civilization as its `civilizations.json` `data_name`
+    /// instead of the number; this sets the number (`civ_id`) from `data_names`, that file's
+    /// `civilization_list` in order (the `.dat`'s civilization order). A save without names is
+    /// left as it is.
+    ///
+    /// # Errors
+    ///
+    /// A name `data_names` does not hold, or an index above 255.
+    pub fn resolve_civ_ids(&mut self, data_names: &[String]) -> Result<(), Error> {
+        for p in &mut self.world.base_world.players {
+            let Some(wp) = p.val.world_player_mut() else { continue };
+            let Some(name) = wp.base.civ_data_name.as_ref() else { continue };
+            let name = String::from_utf8_lossy(&name.bytes).into_owned();
+            let index = data_names.iter().position(|n| *n == name).ok_or_else(|| {
+                GenieError::invalid_input("a civilization name civilizations.json does not hold")
+                    .with("name", &name)
+            })?;
+            wp.base.civ_id = u8::try_from(index).map_err(|_| {
+                GenieError::invalid_input("a civilization index above 255").with("index", index)
+            })?;
+        }
+        Ok(())
+    }
+
+    /// Resolve named save players from explicit, fixed lobby civilization choices.
+    /// Random/ambiguous choices are rejected; canonical install metadata is preferred.
+    pub fn resolve_civ_ids_from_lobby(&mut self, count: usize) -> Result<(), Error> {
+        let lobby = self.file_header.game_options_read.game_options.player_info.clone();
+        for (index, p) in self.world.base_world.players.iter_mut().enumerate() {
+            let Some(wp) = p.val.world_player_mut() else { continue };
+            let Some(name) = wp.base.civ_data_name.as_ref() else { continue };
+            if index == 0 && name.bytes == b"GAIA" { wp.base.civ_id = 0; continue; }
+            let choices: Vec<_> = lobby.iter().filter(|p| p.world_player_array_index_including_gaia as usize == index).collect();
+            if choices.len() != 1 { return Err(GenieError::unsupported("ambiguous lobby civilization identity").with("player", index)); }
+            let choice = &choices[0].civilization_choice;
