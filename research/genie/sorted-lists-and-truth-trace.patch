+fn idle_free_188329(g: &crate::groups::UnitGroup, id: ObjectId) -> bool {
+    if !g.is_idle()
+        || !(g.current_command == GroupCommandKind::NONE
+            || g.current_command == GroupCommandKind::MOVE)
+    {
+        return false;
+    }
+    if g.patrols() {
+        return true;
+    }
+    let Some(slot) = g
+        .current_formation
+        .as_ref()
+        .and_then(|f| f.slots.iter().find(|s| s.unit_id == Some(id)))
+    else {
+        return false;
+    };
+    let failed = g.motion.number_wait_delays.get() == 0
+        && !g.motion.waits_to_move()
+        && g
+            .members
+            .iter()
+            .find(|m| m.id == id)
+            .is_some_and(|m| 3 <= m.specific_move.consecutive_move_failures);
+    failed || slot.state == crate::groups::SlotState::InPlace
+}
