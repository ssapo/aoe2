+/// 188329's slots' assignment globals ([`UnitGroups::slot_assignment`]) behind a lock: the
+/// assignment runs from `&World` and the world is shared between threads.
+#[derive(Debug, Default)]
+pub struct SlotAssignment(std::sync::Mutex<crate::groups::formation::lapjv::Lapjv>);
+
+impl SlotAssignment {
+    /// The globals, to run an assignment on.
+    pub(crate) fn lock(&self) -> std::sync::MutexGuard<'_, crate::groups::formation::lapjv::Lapjv> {
+        self.0.lock().unwrap_or_else(std::sync::PoisonError::into_inner)
+    }
+}
+
+impl Clone for SlotAssignment {
+    fn clone(&self) -> Self {
+        Self(std::sync::Mutex::new(self.lock().clone()))
+    }
+}
+
+impl PartialEq for SlotAssignment {
+    fn eq(&self, other: &Self) -> bool {
+        std::ptr::eq(self, other) || *self.lock() == *other.lock()
+    }
+}
