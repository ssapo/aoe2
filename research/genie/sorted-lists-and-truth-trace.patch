+                }
+            }
+            if std::env::var_os("GENIE_TRACE_SPAWN").is_some() {
+                eprintln!("SPAWNPATH {:?}", points);
+            }
+            super::search::SPAWN_PATH.with(|s| *s.borrow_mut() = points);
+        }
+        Ok(())
+    }
+
+    /// Clears what [`World::spawn_path_set`] left.
+    pub(crate) fn spawn_path_clear() {
+        super::search::SPAWN_PATH.with(|s| *s.borrow_mut() = None);
+    }
+}
