+    let mut queue: Vec<(i32, i32, u16, bool)> = seeds
+        .iter()
+        .map(|&(x, y)| {
+            let flag = (p.point.y() - y).abs() < (p.point.x() - x).abs();
+            (x, y, 0, flag)
+        })
+        .collect();
