--- /dev/null
+++ b/crates/engine/genie-core/src/objects/relic_deposit.rs
@@ -0,0 +1,462 @@
+//! A monk's relic delivery to a monastery (type 0x88; 188329: the factory 0xbb8c30 case 0x88,
+//! constructor 0xbaa690, vtable 0x3227008: `set_state` 0xbaae70, update 0xbaaff0; findings 128,
+//! 152).
+
+use crate::GenieError;
+use crate::garrison::ContainerId;
+use crate::map::Distance;
+use crate::movement::Me;
+use crate::movement::move_to::Patience;
+use crate::movement::move_to::{GiveUp, ListUpdate, MoveToAction, TargetMoved, update_sub_actions};
+use crate::objects::ObjectId;
+use crate::objects::ObjectState;
+use crate::objects::SpriteId;
+use crate::objects::layers::Action;
+use crate::objects::masters::ActionKind;
+use crate::objects::masters::MasterId;
+use crate::objects::masters::Task;
+use crate::objects::teardown::HeadCode;
+use crate::objects::unit::Unit;
+use crate::players::PlayerId;
+use crate::unit_ai::AiAction;
+use crate::unit_ai::NotifyKind;
+use crate::unit_ai::UnitStance;
+use crate::world::Seconds;
+use crate::world::layer::ClassRoles;
+use crate::world::layer::Roles;
+use crate::world::lets::release;
+use crate::world::slots::PlayerSlots;
+use crate::world::step::Step;
+use genie_diff::Diff;
+
+/// The relic delivery's action type (0x88).
+pub const RELIC_DEPOSIT: ActionKind = ActionKind::named(0x88);
+
+/// The monastery's master (the update's and `set_state(4)`'s test of the target, 0x68).
+const MONASTERY: i16 = 0x68;
+
+/// The relic the delivery makes for Gaia at the monk (`FUN_141246920`: master 0x11d).
+const RELIC: i16 = 0x11d;
+
+/// The player attribute a relic in a monastery adds 1.0 to (`0x1283c9a`..: `player+0x98` at
+/// `+0x38`, `DAT_14369ff64` = 1.0).
+const RELICS_HELD: i16 = 7;
+
+/// The wait after a failed walk (state 4's `+0x44` = -0.5).
+const RETRY_WAIT: f32 = -0.5;
+
+/// The states the update reads (`+0x18`).
+#[derive(Clone, Copy, Debug, PartialEq, Diff)]
+pub enum RelicDepositState {
+    /// 1: done.
+    Done,
+    /// 2: halted (after a failure).
+    Halted,
+    /// 4: walking to the monastery, with its quiet `MoveTo` sub-action.
+    Walk {
+        /// The `MoveTo` (0xb92150: range 0, the task's moving sprite, quiet, `+0x6c` 1).
+        move_to: Option<MoveToAction>,
+    },
+    /// 6: at the monastery.
+    AtMonastery,
+    /// 13: failed.
+    Failed,
+}
+
+impl RelicDepositState {
+    /// The state's number.
+    #[must_use]
+    pub const fn get(&self) -> u8 {
+        match self {
+            Self::Done => 1,
+            Self::Halted => 2,
+            Self::Walk { .. } => 4,
+            Self::AtMonastery => 6,
+            Self::Failed => 13,
+        }
+    }
+
+    /// Its `MoveTo`, if it walks with one.
+    #[must_use]
+    pub const fn move_to(&self) -> Option<&MoveToAction> {
+        match self {
+            Self::Walk { move_to } => move_to.as_ref(),
+            _ => None,
+        }
+    }
+}
+
+/// The relic delivery action.
+#[derive(Clone, Copy, Debug, PartialEq, Diff)]
+pub struct RelicDepositAction {
+    /// The monastery (`+0x20`).
+    pub target: Option<ObjectId>,
+    /// `+0x18`, with the `MoveTo` of state 4.
+    pub state: RelicDepositState,
+    /// `+0x44`: state 4's wait after a failed walk (below 0 it counts up by the tick).
+    pub timer: Seconds,
+    /// The task's moving sprite (`+0x40`).
+    pub moving: Option<SpriteId>,
+    /// The task's `+0x12` (its target master): another target of it on a work command of the
+    /// same task is taken (0xbaaa20 / 0xbab380).
+    pub target_master: Option<MasterId>,
+}
+
+impl RelicDepositAction {
+    /// The constructor (0xbaa690) on `target` with `task`: `+0x38`..`+0x40` -1, the target
+    /// taken (0xb6ba50, the caller's), the unit AI's order 0x2db and action 0x277 (the caller's).
+    #[must_use]
+    pub fn new(target: ObjectId, task: &Task) -> Self {
+        Self {
+            target: Some(target),
+            state: RelicDepositState::Walk { move_to: None },
+            timer: Seconds::ZERO,
+            moving: task.sprites.moving,
+            target_master: task.object_id,
+        }
+    }
+}
+
+/// What the action reads of its monastery.
+#[derive(Clone, Copy, Debug)]
+struct Monastery {
+    /// Its master is 0x68.
+    is_monastery: bool,
+    /// Its state is above 6.
+    gone: bool,
+    /// Its state is 2.
+    alive: bool,
+}
+
+impl Unit {
+    /// The relic delivery's update with the action copied out of the list and put back.
+    ///
+    /// # Errors
+    ///
+    /// What the update does not model.
+    pub(crate) fn relic_deposit_part(
+        &mut self,
+        actions: &mut Action,
+        c: &mut Step<'_>,
+        me: Me,
+        roles: &Roles,
+    ) -> Result<HeadCode, GenieError> {
+        let Some(mut a) = actions.list.relic_deposit().copied() else {
+            return Ok(HeadCode::Keeps);
+        };
+        let code = self.relic_deposit_update(&mut a, actions, c, me, roles);
+        if let Some(x) = actions.list.relic_deposit_mut() {
+            *x = a;
+        }
+        code
+    }
+
+    fn monastery_of(c: &Step<'_>, id: Option<ObjectId>) -> Option<Monastery> {
+        let (_, t) = c.w.object(id)?;
+        Some(Monastery {
+            is_monastery: t.life.master_id.get() == MONASTERY,
+            gone: t.life.state > ObjectState::Undead,
+            alive: t.life.state == ObjectState::Alive,
+        })
+    }
+
+    /// `set_state` (0xbaae70): the sub-actions go (a walking `MoveTo`'s teardown stops the
+    /// unit); 4 makes the `MoveTo` to a monastery target (master 0x68), else turns to 13.
+    pub(crate) fn relic_deposit_set_state(
+        &mut self,
+        a: &mut RelicDepositAction,
+        c: &mut Step<'_>,
+        state: RelicDepositState,
+        roles: &Roles,
+    ) -> Result<(), GenieError> {
+        if matches!(a.state, RelicDepositState::Walk { move_to: Some(_) })
+            && let Some(m) = c.w.parts.mover_mut(self.id)
+        {
+            m.stop()?;
+        }
+        a.state = match state {
+            RelicDepositState::Walk { .. } => RelicDepositState::Walk { move_to: None },
+            s => s,
+        };
+        if let RelicDepositState::Walk { .. } = state {
+            if !Self::monastery_of(c, a.target).is_some_and(|m| m.is_monastery) {
+                a.state = RelicDepositState::Failed;
+                return Ok(());
+            }
+            let move_reads = self.move_to_reads(
+                c.w.parts.motion.mover(self.id),
+                c.w.master_tables(),
+                c.player,
+                (
+                    &c.w.model.graphics,
+                    c.w.parts.combat_of(self.id).abilities.look.as_ref(),
+                ),
+                roles,
+            )?;
+            let move_to = match move_reads.walk_to(c.w, a.target)? {
+                Some(to) => move_reads.to_object(
+                    to,
+                    Distance::ZERO,
+                    a.moving,
+                    TargetMoved::Follows,
+                    &c.w.model.tuning.move_to,
+                )?,
+                None => None,
+            };
+            a.state = RelicDepositState::Walk { move_to };
+        }
+        Ok(())
+    }
+
+    /// The update (0xbaaff0).
+    fn relic_deposit_update(
+        &mut self,
+        a: &mut RelicDepositAction,
+        actions: &mut Action,
+        c: &mut Step<'_>,
+        me: Me,
+        roles: &Roles,
+    ) -> Result<HeadCode, GenieError> {
+        if c.w.object(a.target).is_none() && a.target.is_some() {
+            self.relic_deposit_drop(a, c)?;
+        }
+        if Self::monastery_of(c, a.target).is_some_and(|m| m.gone) {
+            self.relic_deposit_drop(a, c)?;
+        }
+        match a.state {
+            RelicDepositState::Done => return Ok(HeadCode::Deletes),
+            RelicDepositState::Walk { .. } => {
+                if Self::monastery_of(c, a.target).is_some_and(|m| m.is_monastery) {
+                    if a.timer.get() < 0.0 {
+                        a.timer = a.timer + c.dt.seconds();
+                        if a.timer.get() < 0.0 {
+                            return Ok(HeadCode::Keeps);
+                        }
+                        a.timer = Seconds::ZERO;
+                        let next = if a.target.is_none() {
+                            RelicDepositState::Failed
+                        } else {
+                            RelicDepositState::Walk { move_to: None }
+                        };
+                        self.relic_deposit_set_state(a, c, next, roles)?;
+                        return Ok(HeadCode::Keeps);
+                    }
+                    let master = self.master(c.w.master_tables(), c.player)?;
+                    let how = ListUpdate {
+                        gives_up: GiveUp {
+                            patience: if roles.of_class(master.class).contains(ClassRoles::VILLAGER)
+                                && !c.w.players.player(c.player)?.kind.is_computer()
+                            {
+                                Patience::WaitsOnce
+                            } else {
+                                Patience::Fails
+                            },
+                            stance: c
+                                .w
+                                .parts
+                                .unit_ai
+                                .get(self.id)
+                                .map_or(UnitStance::Aggressive, |ai| ai.stance),
+                        },
+                        ..ListUpdate::default()
+                    };
+                    let code = match &mut a.state {
+                        RelicDepositState::Walk { move_to } => {
+                            update_sub_actions(move_to, c, self, me, how)?
+                        }
+                        _ => update_sub_actions(&mut None, c, self, me, how)?,
+                    };
+                    match code.get() {
+                        1 | 2 => {
+                            self.relic_deposit_set_state(a, c, RelicDepositState::AtMonastery, roles)?;
+                            return Ok(HeadCode::Keeps);
+                        }
+                        3 | 4 => {
+                            a.timer = Seconds::new(RETRY_WAIT);
+                            return Ok(HeadCode::Keeps);
+                        }
+                        5 => self.relic_deposit_drop(a, c)?,
+                        _ => return Ok(HeadCode::Keeps),
+                    }
+                }
+            }
+            RelicDepositState::AtMonastery => {
+                let Some(m) = Self::monastery_of(c, a.target) else {
+                    return Ok(HeadCode::Keeps);
+                };
+                if !m.alive {
+                    return Ok(HeadCode::Keeps);
+                }
+                if !self.monastery_full(c, a.target)? {
+                    return self.relic_deposit_give(a, actions, c);
+                }
+                // full: the interface's notice 0xbf9 (not held), then 13
+            }
+            RelicDepositState::Failed => {
+                // slot 0x358 with 0x1f9 and 0x267, set_state(2), 3
+                self.post_own(
+                    &mut c.w.parts.unit_ai,
+                    NotifyKind::ACTION_FAILED,
+                    [AiAction::Trade.value(), 0, 0],
+                )?;
+                a.state = RelicDepositState::Halted;
+                // its 3 deletes it (as the pick-up's): the destructor's 0x1fa with 0x277
+                self.post_own(
+                    &mut c.w.parts.unit_ai,
+                    NotifyKind::ACTION_COMPLETED,
+                    [AiAction::OnTarget.value(), 0, 0],
+                )?;
+                return Ok(HeadCode::Deletes);
+            }
+            RelicDepositState::Halted => return Ok(HeadCode::Keeps),
+        }
+        self.relic_deposit_set_state(a, c, RelicDepositState::Failed, roles)?;
+        Ok(HeadCode::Keeps)
+    }
+
+    /// Slot 0x68 with none: the target goes (its slot 0x180).
+    fn relic_deposit_drop(
+        &mut self,
+        a: &mut RelicDepositAction,
+        c: &mut Step<'_>,
+    ) -> Result<(), GenieError> {
+        if let Some(t) = a.target.take() {
+            let by = self.releaser(c)?;
+            release(c, self, Some(t), by)?;
+        }
+        Ok(())
+    }
+
+    /// `FUN_141246170` on the monastery: its slot 0x4d0 (0x12885d0: the objects inside,
+    /// `FUN_1412c7fb0`, less `+0x8dc`) not below its master's garrison capacity. The `+0x8dc`
+    /// count (units of type 70 with `+0x628`) is taken as 0 (not modelled).
+    fn monastery_full(&self, c: &Step<'_>, target: Option<ObjectId>) -> Result<bool, GenieError> {
+        let Some((tp, t)) = c.w.object(target) else {
+            return Ok(false);
+        };
+        let capacity = t.master(c.w.master_tables(), tp)?.garrison.units();
+        Ok(capacity <= t.garrison.len())
+    }
+
+    /// State 6 with room (0xbab06b..): `FUN_141246920(monk, x, y, 1)` — Gaia's slot 0x1c8 makes
+    /// a relic (master 0x11d) where the monk stands; the monk (not in a group here) takes the
+    /// master of its master's delivery task's `work_val1` (slot 0x98 with 1: the action list is
+    /// told, not cleared; slot 0x178 is taken as nothing, `+0x200` empty); the relic's slot 0x1b8
+    /// (0x1250240) puts it in the monastery, whose slot 0x1d8 (0x1283ba0) counts it
+    /// ([`crate::world::World::relic_enters`]). The monk's slot 0x4f8 (a sound) is not held. Its 1
+    /// deletes the action, whose destructor (0xbaa990) tells the unit AI 0x1fa with 0x277.
+    fn relic_deposit_give(
+        &mut self,
+        a: &mut RelicDepositAction,
+        actions: &mut Action,
+        c: &mut Step<'_>,
+    ) -> Result<HeadCode, GenieError> {
+        if self.group.id.is_some() {
+            return Err(GenieError::unsupported("a relic delivery by a group member"));
+        }
+        let Some(monastery) = a.target else {
+            return Ok(HeadCode::Keeps);
+        };
+        let at = self.position();
+        let own = self.master(c.w.master_tables(), c.player)?;
+        let carriers: Vec<MasterId> = own
+            .action_part()
+            .tasks
+            .iter()
+            .filter(|t| t.action_kind == RELIC_DEPOSIT)
+            .map(|t| MasterId::named(t.work_val1.get() as i32 as i16))
+            .collect();
+        c.lend_at((&mut *self, &mut *actions), |w, p, i| {
+            let relic_master = MasterId::named(RELIC);
+            let made = w.master(PlayerId::GAIA, relic_master)?.clone();
+            let ri = w.combat_object(PlayerId::GAIA, relic_master, &made, at)?;
+            for carrier in &carriers {
+                if w.master(p, *carrier).is_ok() {
+                    w.switch_master_keeping_actions(p, i, *carrier)?;
+                }
+            }
+            w.enter_forced(PlayerId::GAIA, ri, ContainerId::new(monastery))?;
+            w.relic_enters(monastery)
+        })?;
+        self.post_own(
+            &mut c.w.parts.unit_ai,
+            NotifyKind::ACTION_COMPLETED,
+            [AiAction::OnTarget.value(), 0, 0],
+        )?;
+        a.state = RelicDepositState::Done;
+        Ok(HeadCode::Deletes)
+    }
+}
+
+impl crate::world::World {
+    /// The start's `set_state(4)` from the work command (0xbaaa10 -> 0xbaae70 case 4): a
+    /// monastery target (master 0x68) gets the quiet `MoveTo` within 0 with the task's moving
+    /// sprite (0xb92150 with 0, `+0x40`, 1, 1), else the action turns to 13.
+    ///
+    /// # Errors
+    ///
+    /// A unit or a master the world lacks, a sprite the table lacks.
+    pub(crate) fn relic_deposit_start(
+        &mut self,
+        player: PlayerId,
+        idx: crate::objects::ListIndex,
+        a: &mut RelicDepositAction,
+    ) -> Result<(), GenieError> {
+        let is_monastery = self
+            .object(a.target)
+            .is_some_and(|(_, t)| t.life.master_id.get() == MONASTERY);
+        if !is_monastery {
+            a.state = RelicDepositState::Failed;
+            return Ok(());
+        }
+        let unit = &self.players.live(player, idx)?;
+        let master = unit.master(self.master_tables(), player)?;
+        let move_reads = crate::movement::move_to::MoveToReads::of(
+            (unit, self.parts.mover_of(unit.id)),
+            master,
+            (
+                &self.model.graphics,
+                self.parts.combat_of(unit.id).abilities.look.as_ref(),
+            ),
+            &self.model.roles,
+        );
+        let move_to = match move_reads.walk_to(self, a.target)? {
+            Some(to) => move_reads.to_object(
+                to,
+                Distance::ZERO,
+                a.moving,
+                TargetMoved::Follows,
+                &self.model.tuning.move_to,
+            )?,
+            None => None,
+        };
+        a.state = RelicDepositState::Walk { move_to };
+        Ok(())
+    }
+
+    /// The monastery's slot 0x1d8 (0x1283ba0) for a relic (class 0x2a) coming in, its owner not
+    /// Gaia (the game's `player+0x88`, taken as set for a player): its relic count (`+0x8d0`)
+    /// grows by one, its owner's attribute 7 by 1.0 and its last whole second (`+0x890`) is now.
+    /// Not held: the owner's tech states' check that follows (`player+0x6d0`) and attribute 39.
+    ///
+    /// # Errors
+    ///
+    /// A monastery the world does not hold.
+    pub(crate) fn relic_enters(&mut self, monastery: ObjectId) -> Result<(), GenieError> {
+        let Some((owner, _)) = self.object(Some(monastery)) else {
+            return Ok(());
+        };
+        if owner == PlayerId::GAIA {
+            return Ok(());
+        }
+        let now = self.world_time;
+        let layer = self.parts.building_mut(monastery)?;
+        layer.relics.count = layer.relics.count.plus_one();
+        layer.garrison_time = now;
+        self.players.player_mut(owner)?.add_attribute(
+            crate::players::attribute::AttributeId::named(RELICS_HELD),
+            crate::players::Amount::new(1.0),
+        )?;
+        Ok(())
+    }
+}
diff --git a/crates/engine/genie-core/src/objects/relic_pickup.rs b/crates/engine/genie-core/src/objects/relic_pickup.rs
new file mode 100644
index 00000000..a8069986
--- /dev/null
+++ b/crates/engine/genie-core/src/objects/relic_pickup.rs
@@ -0,0 +1,418 @@
+//! A monk's relic pick-up (`TRIBE_Action_Pickup`, type 0x84; 188329: the factory 0xbb8c30 case
+//! 0x84, constructor 0xbc2f60, vtable 0x3227ce8: `set_state` 0xbc3760, update 0xbc38e0).
+
+use crate::GenieError;
+use crate::map::Distance;
+use crate::map::Footprint;
+use crate::map::Position;
+use crate::movement::Me;
+use crate::movement::move_to::Patience;
+use crate::movement::move_to::{GiveUp, ListUpdate, MoveToAction, TargetMoved, update_sub_actions};
+use crate::objects::ObjectId;
+use crate::objects::SpriteId;
+use crate::objects::layers::Action;
+use crate::objects::masters::ActionKind;
+use crate::objects::masters::MasterId;
+use crate::objects::masters::Task;
+use crate::objects::teardown::HeadCode;
+use crate::objects::unit::Unit;
+use crate::unit_ai::AiAction;
+use crate::unit_ai::NotifyKind;
+use crate::unit_ai::UnitStance;
+use crate::world::Seconds;
+use crate::world::layer::ClassRoles;
+use crate::world::layer::Roles;
+use crate::world::lets::release;
+use crate::world::slots::PlayerSlots;
+use crate::world::step::Step;
+use genie_diff::Diff;
+
+/// The relic pick-up's action type (0x84).
+pub const RELIC_PICKUP: ActionKind = ActionKind::named(0x84);
+
+/// The in-reach test of state 6 (0x1251e50 with `[0x320532c]` = 0.25).
+const PICKUP_REACH: f32 = 0.25;
+
+/// The wait after a failed walk (state 4's `+0x44` = -0.5).
+const RETRY_WAIT: f32 = -0.5;
+
+/// The states the update reads (`+0x18`).
+#[derive(Clone, Copy, Debug, PartialEq, Diff)]
+pub enum RelicPickupState {
+    /// 1: done.
+    Done,
+    /// 2: halted (after a failure).
+    Halted,
+    /// 4: walking to the relic, with its quiet `MoveTo` sub-action.
+    Walk {
+        /// The `MoveTo` (0xb92150: range 0, the task's moving sprite, quiet, `+0x6c` 1).
+        move_to: Option<MoveToAction>,
+    },
+    /// 6: at the relic.
+    AtRelic,
+    /// 13: failed.
+    Failed,
+}
+
+impl RelicPickupState {
+    /// The state's number.
+    #[must_use]
+    pub const fn get(&self) -> u8 {
+        match self {
+            Self::Done => 1,
+            Self::Halted => 2,
+            Self::Walk { .. } => 4,
+            Self::AtRelic => 6,
+            Self::Failed => 13,
+        }
+    }
+
+    /// Its `MoveTo`, if it walks with one.
+    #[must_use]
+    pub const fn move_to(&self) -> Option<&MoveToAction> {
+        match self {
+            Self::Walk { move_to } => move_to.as_ref(),
+            _ => None,
+        }
+    }
+}
+
+/// The relic pick-up action.
+#[derive(Clone, Copy, Debug, PartialEq, Diff)]
+pub struct RelicPickupAction {
+    /// The relic (`+0x20`).
+    pub target: Option<ObjectId>,
+    /// `+0x18`, with the `MoveTo` of state 4.
+    pub state: RelicPickupState,
+    /// `+0x44`: state 4's wait after a failed walk (below 0 it counts up by the tick).
+    pub timer: Seconds,
+    /// The task's `+0x28` (`work_val1`) as a master: the unit's master once it holds the relic.
+    pub carrier: MasterId,
+    /// The task's moving sprite (`+0x40`).
+    pub moving: Option<SpriteId>,
+}
+
+impl RelicPickupAction {
+    /// The constructor (0xbc2f60) on `target` with `task`: `+0x38`..`+0x40` -1, the target
+    /// taken (0xb6ba50, the caller's); the walk of the start (slot 0x28 = 0xbc3310,
+    /// `set_state(4)`) is the caller's ([`Unit::relic_pickup_walk`]).
+    #[must_use]
+    pub fn new(target: ObjectId, task: &Task) -> Self {
+        Self {
+            target: Some(target),
+            state: RelicPickupState::Walk { move_to: None },
+            timer: Seconds::ZERO,
+            carrier: MasterId::named(task.work_val1.get() as i32 as i16),
+            moving: task.sprites.moving,
+        }
+    }
+}
+
+/// The footprints' squared gap of 0x1251e50: `(|dx| - ra) - rb` (and so for y) at least 0.
+fn gap_squared(a: Position, ra: Footprint, b: Position, rb: Footprint) -> f32 {
+    let x = (((b.x() - a.x()).abs() - ra.x()) - rb.x()).max(0.0);
+    let y = (((b.y() - a.y()).abs() - ra.y()) - rb.y()).max(0.0);
+    x * x + y * y
+}
+
+/// What the action reads of its relic.
+#[derive(Clone, Copy, Debug)]
+struct Relic {
+    /// The relic is of the relics' class (0x2a).
+    is_relic: bool,
+    /// Its state is above 6.
+    gone: bool,
+    position: Position,
+    radius: Footprint,
+}
+
+impl Unit {
+    /// The relic pick-up's update with the action copied out of the list and put back.
+    ///
+    /// # Errors
+    ///
+    /// What the update does not model.
+    pub(crate) fn relic_pickup_part(
+        &mut self,
+        actions: &mut Action,
+        c: &mut Step<'_>,
+        me: Me,
+        roles: &Roles,
+    ) -> Result<HeadCode, GenieError> {
+        let Some(mut a) = actions.list.relic_pickup().copied() else {
+            return Ok(HeadCode::Keeps);
+        };
+        let code = self.relic_pickup_update(&mut a, actions, c, me, roles);
+        if let Some(x) = actions.list.relic_pickup_mut() {
+            *x = a;
+        }
+        code
+    }
+
+    fn relic_of(&self, c: &Step<'_>, id: Option<ObjectId>, roles: &Roles) -> Result<Option<Relic>, GenieError> {
+        let Some((tp, t)) = c.w.object(id) else {
+            return Ok(None);
+        };
+        let m = t.master(c.w.master_tables(), tp)?;
+        Ok(Some(Relic {
+            is_relic: roles.of_class(m.class).contains(ClassRoles::RELIC),
+            gone: t.life.state > crate::objects::ObjectState::Undead,
+            position: t.position(),
+            radius: m.radius,
+        }))
+    }
+
+    /// `set_state` (0xbc3760): the sub-actions go (a walking `MoveTo`'s teardown stops the
+    /// unit); 4 makes the `MoveTo` to a relic target (class 0x2a), else turns to 13.
+    pub(crate) fn relic_pickup_set_state(
+        &mut self,
+        a: &mut RelicPickupAction,
+        c: &mut Step<'_>,
+        state: RelicPickupState,
+        roles: &Roles,
+    ) -> Result<(), GenieError> {
+        if matches!(a.state, RelicPickupState::Walk { move_to: Some(_) })
+            && let Some(m) = c.w.parts.mover_mut(self.id)
+        {
+            m.stop()?;
+        }
+        a.state = match state {
+            RelicPickupState::Walk { .. } => RelicPickupState::Walk { move_to: None },
+            s => s,
+        };
+        if let RelicPickupState::Walk { .. } = state {
+            let relic = self.relic_of(c, a.target, roles)?;
+            if !relic.is_some_and(|r| r.is_relic) {
+                a.state = RelicPickupState::Failed;
+                return Ok(());
+            }
+            let move_reads = self.move_to_reads(
+                c.w.parts.motion.mover(self.id),
+                c.w.master_tables(),
+                c.player,
+                (
+                    &c.w.model.graphics,
+                    c.w.parts.combat_of(self.id).abilities.look.as_ref(),
+                ),
+                roles,
+            )?;
+            let move_to = match move_reads.walk_to(c.w, a.target)? {
+                Some(to) => move_reads.to_object(
+                    to,
+                    Distance::ZERO,
+                    a.moving,
+                    TargetMoved::Follows,
+                    &c.w.model.tuning.move_to,
+                )?,
+                None => None,
+            };
+            a.state = RelicPickupState::Walk { move_to };
+        }
+        Ok(())
+    }
+
+    /// The update (0xbc38e0).
+    fn relic_pickup_update(
+        &mut self,
+        a: &mut RelicPickupAction,
+        actions: &mut Action,
+        c: &mut Step<'_>,
+        me: Me,
+        roles: &Roles,
+    ) -> Result<HeadCode, GenieError> {
+        let relic = self.relic_of(c, a.target, roles)?;
+        if relic.is_some_and(|r| r.gone) {
+            self.relic_pickup_drop(a, c)?;
+        }
+        match a.state {
+            RelicPickupState::Done => return Ok(HeadCode::Deletes),
+            RelicPickupState::Walk { .. } => {
+                let relic = self.relic_of(c, a.target, roles)?;
+                if relic.is_some_and(|r| r.is_relic) {
+                    if a.timer.get() < 0.0 {
+                        a.timer = a.timer + c.dt.seconds();
+                        if a.timer.get() < 0.0 {
+                            return Ok(HeadCode::Keeps);
+                        }
+                        a.timer = Seconds::ZERO;
+                        let next = RelicPickupState::Walk { move_to: None };
+                        self.relic_pickup_set_state(a, c, next, roles)?;
+                        return Ok(HeadCode::Keeps);
+                    }
+                    let master = self.master(c.w.master_tables(), c.player)?;
+                    let how = ListUpdate {
+                        gives_up: GiveUp {
+                            patience: if roles.of_class(master.class).contains(ClassRoles::VILLAGER)
+                                && !c.w.players.player(c.player)?.kind.is_computer()
+                            {
+                                Patience::WaitsOnce
+                            } else {
+                                Patience::Fails
+                            },
+                            stance: c
+                                .w
+                                .parts
+                                .unit_ai
+                                .get(self.id)
+                                .map_or(UnitStance::Aggressive, |ai| ai.stance),
+                        },
+                        ..ListUpdate::default()
+                    };
+                    let code = match &mut a.state {
+                        RelicPickupState::Walk { move_to } => {
+                            update_sub_actions(move_to, c, self, me, how)?
+                        }
+                        _ => update_sub_actions(&mut None, c, self, me, how)?,
+                    };
+                    match code.get() {
+                        1 | 2 => {
+                            self.relic_pickup_set_state(a, c, RelicPickupState::AtRelic, roles)?;
+                            return Ok(HeadCode::Keeps);
+                        }
+                        3 | 4 => {
+                            a.timer = Seconds::new(RETRY_WAIT);
+                            return Ok(HeadCode::Keeps);
+                        }
+                        5 => self.relic_pickup_drop(a, c)?,
+                        _ => return Ok(HeadCode::Keeps),
+                    }
+                }
+            }
+            RelicPickupState::AtRelic => {
+                let Some(r) = self.relic_of(c, a.target, roles)? else {
+                    return Ok(HeadCode::Keeps);
+                };
+                let own = self.master(c.w.master_tables(), c.player)?;
+                let gap = gap_squared(self.position(), own.radius, r.position, r.radius);
+                if !(PICKUP_REACH * PICKUP_REACH < gap) {
+                    return self.relic_pickup_take(a, actions, c);
+                }
+            }
+            RelicPickupState::Failed => {
+                self.post_own(
+                    &mut c.w.parts.unit_ai,
+                    NotifyKind::ACTION_FAILED,
+                    [AiAction::OnTarget.value(), 0, 0],
+                )?;
+                a.state = RelicPickupState::Halted;
+                self.relic_pickup_done(c)?;
+                return Ok(HeadCode::Deletes);
+            }
+            RelicPickupState::Halted => return Ok(HeadCode::Keeps),
+        }
+        self.relic_pickup_set_state(a, c, RelicPickupState::Failed, roles)?;
+        Ok(HeadCode::Keeps)
+    }
+
+    /// Slot 0x68 with none: the target goes (its slot 0x180).
+    fn relic_pickup_drop(&mut self, a: &mut RelicPickupAction, c: &mut Step<'_>) -> Result<(), GenieError> {
+        if let Some(t) = a.target.take() {
+            let by = self.releaser(c)?;
+            release(c, self, Some(t), by)?;
+        }
+        Ok(())
+    }
+
+    /// The destructor's notify (0xbc3280: slot 0x358 with 0x1fa and action 0x277), posted as
+    /// the update deletes the action.
+    fn relic_pickup_done(&self, c: &mut Step<'_>) -> Result<(), GenieError> {
+        self.post_own(
+            &mut c.w.parts.unit_ai,
+            NotifyKind::ACTION_COMPLETED,
+            [AiAction::OnTarget.value(), 0, 0],
+        )
+    }
+
+    /// State 6 in reach (0xbc3a2f~): the relic's slot 0xd8 (0x113b390: it leaves the world, its
+    /// hit points 0), the target goes; a unit in a group is not modelled (0x10f64b0,
+    /// 0x10d3c50, 0x110d5e0); the master becomes the task's carrier (slot 0x98 with 0) when the
+    /// player has it (0x1728c10). Its 1 deletes the action. Not held: the game's event 0x8c,
+    /// the capture-the-relic mode's (game type 10) parts.
+    fn relic_pickup_take(
+        &mut self,
+        a: &mut RelicPickupAction,
+        actions: &mut Action,
+        c: &mut Step<'_>,
+    ) -> Result<HeadCode, GenieError> {
+        if self.group.id.is_some() {
+            return Err(GenieError::unsupported("a relic pick-up by a group member"));
+        }
+        let relic = a.target;
+        self.relic_pickup_drop(a, c)?;
+        if let Some(r) = relic {
+            c.w.relic_taken(r)?;
+        }
+        self.relic_pickup_done(c)?;
+        a.state = RelicPickupState::Done;
+        let carrier = a.carrier;
+        if c.w.master(c.player, carrier).is_ok() {
+            c.lend_at((&mut *self, &mut *actions), |w, p, i| w.change_master(p, i, carrier))?;
+        }
+        Ok(HeadCode::Deletes)
+    }
+}
+
+impl crate::world::World {
+    /// The start's `set_state(4)` from the work command (0xbc3310 -> 0xbc3760 case 4): a relic
+    /// target (class 0x2a) gets the quiet `MoveTo` within 0 with the task's moving sprite
+    /// (0xb92150 with 0, `+0x40`, 1, 1), else the action turns to 13.
+    ///
+    /// # Errors
+    ///
+    /// A unit or a master the world lacks, a sprite the table lacks.
+    pub(crate) fn relic_pickup_start(
+        &mut self,
+        player: crate::players::PlayerId,
+        idx: crate::objects::ListIndex,
+        a: &mut RelicPickupAction,
+    ) -> Result<(), GenieError> {
+        let is_relic = match self.object(a.target) {
+            Some((tp, t)) => {
+                let m = t.master(self.master_tables(), tp)?;
+                self.model.roles.of_class(m.class).contains(ClassRoles::RELIC)
+            }
+            None => false,
+        };
+        if !is_relic {
+            a.state = RelicPickupState::Failed;
+            return Ok(());
+        }
+        let unit = &self.players.live(player, idx)?;
+        let master = unit.master(self.master_tables(), player)?;
+        let move_reads = crate::movement::move_to::MoveToReads::of(
+            (unit, self.parts.mover_of(unit.id)),
+            master,
+            (
+                &self.model.graphics,
+                self.parts.combat_of(unit.id).abilities.look.as_ref(),
+            ),
+            &self.model.roles,
+        );
+        let move_to = match move_reads.walk_to(self, a.target)? {
+            Some(to) => move_reads.to_object(
+                to,
+                Distance::ZERO,
+                a.moving,
+                TargetMoved::Follows,
+                &self.model.tuning.move_to,
+            )?,
+            None => None,
+        };
+        a.state = RelicPickupState::Walk { move_to };
+        Ok(())
+    }
+
+    /// The relic's slot 0xd8 (0x113b390): it wakes and its hit points go to 0.
+    ///
+    /// # Errors
+    ///
+    /// A relic the world does not hold.
+    pub(crate) fn relic_taken(&mut self, id: ObjectId) -> Result<(), GenieError> {
+        let Some((owner, _)) = self.object(Some(id)) else {
+            return Ok(());
+        };
+        let i = self.wake(id)?;
+        self.players.live_mut(owner, i)?.life.hp = crate::objects::HitPoints::ZERO;
+        Ok(())
+    }
+}
diff --git a/crates/engine/genie-core/src/objects/unpack.rs b/crates/engine/genie-core/src/objects/unpack.rs
new file mode 100644
index 00000000..ba176db4
--- /dev/null
+++ b/crates/engine/genie-core/src/objects/unpack.rs
@@ -0,0 +1,421 @@
+//! A packed siege engine's unpack (type 0x7d; 188329: the factory 0xbb8c30 case 0x7d ->
+//! 0xbb94de, constructor 0xbcf0c0, vtable 0x3228238: start (slot 5) 0xbd1230, update (slot 6)
+//! 0xbd2f80, `set_state` (slot 16) 0xbd2950, the destructor 0xbd06e0; findings 170).
+//!
+//! The slice models the walk to the target within the unpacked master's range (state 11); the
+//! unpacking itself (states 2 and 6, the master change), the pack before it (state 10) and the
+//! walk without a target stop as unsupported.
+
+use crate::GenieError;
+use crate::map::Distance;
+use crate::map::Position;
+use crate::math::rng::Stream;
+use crate::movement::Me;
+use crate::movement::footprint_gap_squared;
+use crate::movement::move_to::Patience;
+use crate::movement::move_to::{
+    GiveUp, ListUpdate, MoveToAction, MoveToReads, TargetMoved, update_sub_actions,
+};
+use crate::objects::ListIndex;
+use crate::objects::ObjectId;
+use crate::objects::ObjectState;
+use crate::objects::SpriteId;
+use crate::objects::layers::Action;
+use crate::objects::masters::ActionKind;
+use crate::objects::masters::Master;
+use crate::objects::masters::MasterId;
+use crate::objects::masters::MasterKind;
+use crate::objects::teardown::HeadCode;
+use crate::objects::unit::Unit;
+use crate::players::PlayerId;
+use crate::unit_ai::Notifies;
+use crate::unit_ai::UnitStance;
+use crate::world::World;
+use crate::world::layer::ClassRoles;
+use crate::world::layer::Roles;
+use crate::world::lets::release;
+use crate::world::slots::PlayerSlots;
+use crate::world::step::Step;
+use genie_diff::Diff;
+
+/// The unpack's action type (0x7d).
+pub const UNPACK: ActionKind = ActionKind::UNPACK;
+
+/// The constructor's range less this (`[0x143202890]` = 0.1).
+const RANGE_SHORT: f32 = 0.1;
+
+/// The unpack's state (`+0x18`) with the `MoveTo` of its walk.
+#[derive(Clone, Copy, Debug, PartialEq, Diff)]
+pub enum UnpackState {
+    /// 1: done (its update returns 1).
+    Done,
+    /// 11: walking to the target (or the point) within the range.
+    Walk {
+        /// The quiet `MoveTo` (0xb92150 with the range, the own master's walking sprite
+        /// `+0x1e8`, 1, 1; 0xb6b990 with 1).
+        move_to: Option<MoveToAction>,
+    },
+}
+
+impl UnpackState {
+    /// The state's number.
+    #[must_use]
+    pub const fn get(&self) -> u8 {
+        match self {
+            Self::Done => 1,
+            Self::Walk { .. } => 11,
+        }
+    }
+
+    /// Its walk's `MoveTo`, if it walks with one.
+    #[must_use]
+    pub const fn move_to(&self) -> Option<&MoveToAction> {
+        match self {
+            Self::Walk { move_to } => move_to.as_ref(),
+            Self::Done => None,
+        }
+    }
+}
+
+/// The unpack action (0x90 bytes).
+#[derive(Clone, Copy, Debug, PartialEq, Diff)]
+pub struct UnpackAction {
+    /// The target (`+0x20`, `+0x30`).
+    pub target: Option<ObjectId>,
+    /// `+0x18`.
+    pub state: UnpackState,
+    /// `+0x38`, `+0x3c`: the constructor's point (the work command's).
+    pub point: Position,
+    /// `+0x70`: the unpacked master's range less 0.1 (0 without a target).
+    pub range: Distance,
+    /// `+0x82`: the master it unpacks from (the unit's own).
+    pub own: MasterId,
+    /// `+0x84`: the master it unpacks into (the task's `+0x12`).
+    pub into: MasterId,
+    /// `+0x80`: the task's `work_val1`, the unpacking's length.
+    pub length: i16,
+    /// `+0x88`: the flags of the task's `+0x34` (0x10 -> 1, 0x20 -> 2, 8 -> 4, 0x40 -> 8,
+    /// 0x80 -> 0x10, 0x200 -> 0x20).
+    pub flags: u8,
+    /// `+0x87`: 0 until the master changes (1, 2 while it unpacks).
+    pub stage: u8,
+}
+
+/// The unpack info of a master (0x12f3c60) from its first task of type 0x7d (0x116a370): the
+/// task's `+0x12` (the master it unpacks into), its `work_val1` (the length) and the flags of
+/// its `+0x34`. None for a master without one; master 444 and class 51 without such a task take
+/// other values, not modelled.
+fn unpack_info(master: &Master) -> Result<Option<(MasterId, i16, u8)>, GenieError> {
+    let Some(task) = master
+        .action_part()
+        .tasks
+        .iter()
+        .find(|t| t.action_kind == UNPACK)
+    else {
+        if master.id.get() == 0x1bc || master.class.get() == 0x33 {
+            return Err(GenieError::unsupported(
+                "an unpack of master 444 or class 51 without an unpack task (0x12f3c60)",
+            ));
+        }
+        return Ok(None);
+    };
+    let into = task.object_id.ok_or(GenieError::unsupported(
+        "an unpack task without its master (0x12f3c60)",
+    ))?;
+    let w = task.work_flag;
+    let mut flags = 0u8;
+    for (bit, flag) in [(0x10, 1), (0x20, 2), (8, 4), (0x40, 8), (0x80, 0x10), (0x200, 0x20)] {
+        if w & bit != 0 {
+            flags |= flag;
+        }
+    }
+    Ok(Some((into, task.work_val1.get() as i32 as i16, flags)))
+}
+
+/// Whether the master has the pack info (0x12f38b0): a task of type 0x7c (0x116a370), class 54,
+/// or master 109 (under its own rules).
+fn packs_first(master: &Master) -> bool {
+    master
+        .action_part()
+        .tasks
+        .iter()
+        .any(|t| t.action_kind == ActionKind::PACK)
+        || master.class.get() == 0x36
+        || master.id.get() == 0x6d
+}
+
+impl Unit {
+    /// The unpack's update with the action copied out of the list and put back.
+    ///
+    /// # Errors
+    ///
+    /// What the update does not model.
+    pub(crate) fn unpack_part(
+        &mut self,
+        actions: &mut Action,
+        c: &mut Step<'_>,
+        me: Me,
+        roles: &Roles,
+    ) -> Result<HeadCode, GenieError> {
+        let Some(mut a) = actions.list.unpack().copied() else {
+            return Ok(HeadCode::Keeps);
+        };
+        let code = self.unpack_update(&mut a, c, me, roles);
+        if let Some(x) = actions.list.unpack_mut() {
+            *x = a;
+        }
+        code
+    }
+
+    /// Slot 0x68 with none: the target goes (its slot 0x180).
+    fn unpack_drop(&mut self, a: &mut UnpackAction, c: &mut Step<'_>) -> Result<(), GenieError> {
+        if let Some(t) = a.target.take() {
+            let by = self.releaser(c)?;
+            release(c, self, Some(t), by)?;
+        }
+        Ok(())
+    }
+
+    /// The update (0xbd2f80): a target gone or above state 2 goes (slot 0x68 with 0); then by
+    /// the state. 11: the `MoveTo`'s code (0xb8ae30): 1 or 2 unpack (6); 0 and 3 test the
+    /// footprints' squared gap (0x124daf0) against the squared range: within it unpacks (6),
+    /// else 3 fails (13) and 0 walks on; 4 lets the target go and walks again (11).
+    fn unpack_update(
+        &mut self,
+        a: &mut UnpackAction,
+        c: &mut Step<'_>,
+        me: Me,
+        roles: &Roles,
+    ) -> Result<HeadCode, GenieError> {
+        if a.target.is_some() {
+            let gone = match c.w.object(a.target) {
+                None => true,
+                Some((_, t)) => ObjectState::Alive < t.life.state,
+            };
+            if gone {
+                self.unpack_drop(a, c)?;
+            }
+        }
+        match a.state {
+            UnpackState::Done => Ok(HeadCode::Deletes),
+            UnpackState::Walk { .. } => {
+                let code = self.unpack_walk(a, c, me, roles)?;
+                match code {
+                    1 | 2 => Err(UNPACKING),
+                    0 | 3 => {
+                        let Some((tp, t)) = c.w.object(a.target) else {
+                            return Err(GenieError::unsupported(
+                                "an unpack's walk without its target (0xbd30b4)",
+                            ));
+                        };
+                        let tr = t.master(c.w.master_tables(), tp)?.radius;
+                        let at = t.position();
+                        let own = self.master(c.w.master_tables(), c.player)?.radius;
+                        let gap2 = footprint_gap_squared(self.position(), own, at, tr).get();
+                        let r = a.range.get();
+                        // COMISS, JB: within the range (NaN out)
+                        if r * r >= gap2 {
+                            return Err(UNPACKING);
+                        }
+                        if code == 3 {
+                            return Err(GenieError::unsupported(
+                                "an unpack's failed walk (set_state 13)",
+                            ));
+                        }
+                        Ok(HeadCode::Keeps)
+                    }
+                    4 => Err(GenieError::unsupported(
+                        "an unpack's walk again after its target moved (0xbd3077)",
+                    )),
+                    _ => Ok(HeadCode::Keeps),
+                }
+            }
+        }
+    }
+
+    /// The `MoveTo`'s update (0xb8ae30) and its code.
+    fn unpack_walk(
+        &mut self,
+        a: &mut UnpackAction,
+        c: &mut Step<'_>,
+        me: Me,
+        roles: &Roles,
+    ) -> Result<u8, GenieError> {
+        let master = self.master(c.w.master_tables(), c.player)?;
+        let how = ListUpdate {
+            gives_up: GiveUp {
+                patience: if roles.of_class(master.class).contains(ClassRoles::VILLAGER)
+                    && !c.w.players.player(c.player)?.kind.is_computer()
+                {
+                    Patience::WaitsOnce
+                } else {
+                    Patience::Fails
+                },
+                stance: c
+                    .w
+                    .parts
+                    .unit_ai
+                    .get(self.id)
+                    .map_or(UnitStance::Aggressive, |ai| ai.stance),
+            },
+            ..ListUpdate::default()
+        };
+        let code = match &mut a.state {
+            UnpackState::Walk { move_to } => update_sub_actions(move_to, c, self, me, how)?,
+            UnpackState::Done => update_sub_actions(&mut None, c, self, me, how)?,
+        };
+        Ok(code.get())
+    }
+}
+
+/// The unpacking itself (`set_state` 6 and 2: the master change, the length counted) is not
+/// modelled.
+const UNPACKING: GenieError =
+    GenieError::unsupported("an unpack's unpacking (set_state 6, 0xbd2950)");
+
+impl World {
+    /// The factory's unpack (0xbb8c30 case 0x7d -> 0xbb94de, constructor 0xbcf0c0 with the work's
+    /// point and -1) on `target` from the work command: the action takes the target (0xb6ba50);
+    /// its own master (`+0x82`) is the unit's (no pack info, 0x12f3bd0) and the unpack info of it
+    /// (0x12f3c60) gives the master it unpacks into (`+0x84`), the length and the flags; the range
+    /// (`+0x70`) is that master's weapon range (0x1280c80: `+0x2c8` through the unit's own
+    /// modifiers 0x1241910, which the slice does not hold) less 0.1. The unit AI hears type
+    /// 0x7d (slot 0x8e8 -> 0x113e030: order and action −1, the target with its class at the
+    /// point); the install (slot 0x8c8) clears the action list and the list's add starts it
+    /// (slot 5 with 1, [`World::unpack_start`]).
+    ///
+    /// # Errors
+    ///
+    /// What the start does not model, a unit or master the world lacks.
+    pub(crate) fn start_unpack(
+        &mut self,
+        player: PlayerId,
+        idx: ListIndex,
+        (target, point): (ObjectId, Position),
+        notifies: Notifies,
+    ) -> Result<(), GenieError> {
+        let unit = self.players.live(player, idx)?;
+        let id = unit.id;
+        let own = unit.master(self.master_tables(), player)?.clone();
+        if own.kind < MasterKind::BUILDING {
+            return Err(GenieError::unsupported(
+                "an unpack by a unit of a type below 80 (0xbd0d90)",
+            ));
+        }
+        if packs_first(&own) {
+            return Err(GenieError::unsupported(
+                "an unpack by a unit with the pack info (0x12f3bd0, set_state 10)",
+            ));
+        }
+        let (into, length, flags) = unpack_info(&own)?.ok_or(GenieError::unsupported(
+            "an unpack by a master without the unpack info (0xbd0d90)",
+        ))?;
+        if flags & 0x20 != 0 {
+            return Err(GenieError::unsupported(
+                "an unpack whose task's flag 0x200 marks its point (0xbd1080)",
+            ));
+        }
+        let (tp, t) = self.object(Some(target)).ok_or(GenieError::unsupported(
+            "an unpack's target the world does not hold",
+        ))?;
+        let class = t.master(self.master_tables(), tp)?.class;
+        let range = match self.master(player, into) {
+            Ok(m) if MasterKind::COMBAT <= m.kind => {
+                Distance::new(m.combat_part().weapon_range.get() - RANGE_SHORT)
+            }
+            _ => Distance::ZERO,
+        };
+        let mut a = UnpackAction {
+            target: Some(target),
+            state: UnpackState::Walk { move_to: None },
+            point: Position::new(point.x(), point.y(), 0.0),
+            range,
+            own: own.id,
+            into,
+            length,
+            flags,
+            stage: 0,
+        };
+        self.take(target, self.releaser(player, idx)?)?;
+        if let Some(ai) = self.parts.unit_ai.get_mut(id) {
+            ai.notify_work(
+                None,
+                None,
+                Some((target, class)),
+                point,
+                notifies,
+                self.streams.get(Stream::Ai),
+            )?;
+            self.remember_order(player, idx, (None, None))?;
+        }
+        self.clear_actions(player, idx)?;
+        self.unpack_start(player, idx, &mut a)?;
+        self.parts.actions_mut(id)?.list.set_unpack(Some(a));
+        Ok(())
+    }
+
+    /// The start (slot 5 with 1, 0xbd1230): with its own master and the one it unpacks into (of
+    /// a type of at least 80) in the player's table, a unit in a group leaves it (0x10f64b0 with
+    /// −1 and 0: it stands); without the pack info (0x12f3bd0) `set_state(11)`: the sub-actions
+    /// go and the quiet `MoveTo` to the target within the range with the own master's walking
+    /// sprite (0xb92150 with 1, 1; 0xb6b990 with 1). Else 13, not modelled.
+    ///
+    /// # Errors
+    ///
+    /// What the start does not model, a unit or master the world lacks.
+    pub(crate) fn unpack_start(
+        &mut self,
+        player: PlayerId,
+        idx: ListIndex,
+        a: &mut UnpackAction,
+    ) -> Result<(), GenieError> {
+        let own = self.master(player, a.own).ok().cloned();
+        let into_ok = self
+            .master(player, a.into)
+            .is_ok_and(|m| MasterKind::BUILDING <= m.kind);
+        let Some(own) = own.filter(|_| into_ok) else {
+            return Err(GenieError::unsupported(
+                "an unpack's start without its masters (set_state 13)",
+            ));
+        };
+        let unit = self.players.live(player, idx)?;
+        let id = unit.id;
+        if let Some(group) = unit.group.id {
+            let _ = self.remove_unit(group, id, None, crate::groups::LeavingWalk::Stands)?;
+        }
+        let unit = self.players.live(player, idx)?;
+        if packs_first(unit.master(self.master_tables(), player)?) {
+            return Err(GenieError::unsupported(
+                "an unpack's start with the pack info (set_state 10)",
+            ));
+        }
+        let master = unit.master(self.master_tables(), player)?;
+        let move_reads = MoveToReads::of(
+            (unit, self.parts.mover_of(id)),
+            master,
+            (
+                &self.model.graphics,
+                self.parts.combat_of(id).abilities.look.as_ref(),
+            ),
+            &self.model.roles,
+        );
+        let to = move_reads
+            .walk_to(self, a.target)?
+            .ok_or(GenieError::unsupported("an unpack's walk without its target"))?;
+        let sprite: Option<SpriteId> = own.moving_part().move_sprite;
+        let walk = move_reads.to_object(
+            to,
+            a.range,
+            sprite,
+            TargetMoved::AsksAgain,
+            &self.model.tuning.move_to,
+        )?;
+        if a.state.move_to().is_some()
+            && let Some(m) = self.parts.mover_mut(id)
+        {
+            m.stop()?;
+        }
+        a.state = UnpackState::Walk { move_to: walk };
+        Ok(())
+    }
+}
diff --git a/crates/engine/genie-core/src/orders/repair_command.rs b/crates/engine/genie-core/src/orders/repair_command.rs
new file mode 100644
index 00000000..886df08f
--- /dev/null
+++ b/crates/engine/genie-core/src/orders/repair_command.rs
@@ -0,0 +1,200 @@
+//! REPAIR's units (build 188329's handler `0xf653d0`): the queue path and the direct repair
+//! (`0x12c66c0`).
+
+use crate::GenieError;
+use crate::construction::repair::REPAIR;
+use crate::map::Distance;
+use crate::map::Position;
+use crate::math::fmath::below_or_unordered;
+use crate::math::rng::Stream;
+use crate::movement::Speed;
+use crate::objects::ListIndex;
+use crate::objects::ObjectId;
+use crate::objects::masters::ClassId;
+use crate::objects::masters::MasterKind;
+use crate::objects::masters::PlayersMasters;
+use crate::objects::masters::TaskGroup;
+use crate::orders::Dispatch;
+use crate::orders::{ReadyOrders, readiness};
+use crate::players::PlayerId;
+use crate::unit_ai::Notifies;
+use crate::unit_ai::OrderKind;
+use crate::unit_ai::QueueEnd;
+use crate::unit_ai::{Issuer, OrderPriority, OrderTargetKind, QueuedOrder};
+use crate::world::World;
+use crate::world::index::Place;
+use crate::world::slots::PlayerSlots;
+
+/// The class whose units keep their master for the direct repair (`0x12c66c0`: the master's
+/// class field reads `0x1782`, the class `0x42` under the field's key `0x17c0`).
+const KEEPS_MASTER: ClassId = ClassId::named(0x42);
+
+impl World {
+    /// REPAIR's handler (build 188329, `0xf653d0`) on `target` with the packet's units after the
+    /// check. Nothing for a target the world does not hold, or when it holds none of the units.
+    /// The order splitter (`0x10b6e50`) takes the units; a group it forms (which the handler
+    /// commands with the group command `0x10d8230`, order `0x6a`) is not modelled. The command
+    /// is counted (`0x14435f084`). Then each loose unit, in the splitter's order: it leaves its
+    /// group (`0x10f64b0` with no target); one of a master of type 30 and up that moves (its
+    /// slot 0xe8), or any of a queued command, takes the order: without a unit AI, or of a
+    /// command not queued that is direct or whose unit AI holds no order not ready
+    /// (`0xd27720`), the direct repair ([`World::repair_directly`]); any other unit AI queues
+    /// the repair order `0x2ce` on the target at the target's place (slot 0x30: issued by the
+    /// unit's own player, priority 100, ready when direct), and after a command neither queued
+    /// nor direct the readiness pass with 1 (`0xd1d140`) and the unit's stop.
+    pub(crate) fn repair_units(
+        &mut self,
+        units: &[Option<ObjectId>],
+        target: ObjectId,
+        (queued, direct): (bool, bool),
+    ) -> Result<(), GenieError> {
+        let Some((tp, t)) = self.object(target) else {
+            return Ok(());
+        };
+        let (at, target_master) = (t.position(), t.life.master_id);
+        if !units.iter().flatten().any(|&id| self.place(id).is_some()) {
+            return Ok(());
+        }
+        let loose = self.loose_units(units);
+        self.groups.count_command();
+        for id in loose? {
+            self.leave_group_of(id, None)?;
+            let Some((q, unit)) = self.object(id) else {
+                continue;
+            };
+            let m = unit.master(self.master_tables(), q)?;
+            let speed = m.move_stats.map_or(Speed::ZERO, |s| s.speed);
+            let moves = MasterKind::MOVING <= m.kind && below_or_unordered(0.0, speed.get());
+            if !moves && !queued {
+                continue;
+            }
+            let Some(Place::Live(q, idx)) = self.place(id) else {
+                continue;
+            };
+            let takes_it = self
+                .parts
+                .unit_ai
+                .get(id)
+                .is_none_or(|ai| !queued && (direct || !ai.has_unready_order()));
+            if takes_it {
+                self.repair_directly(q, idx, target)?;
+                continue;
+            }
+            let state = self.players.live(q, idx)?.life.state;
+            let order = QueuedOrder {
+                issuer: Some(Issuer::Player(q)),
+                order: OrderKind::Repair,
+                priority: OrderPriority::COMMAND,
+                target: Some(target),
+                target_owner: Some(tp),
+                point: Position::new(at.x(), at.y(), 0.0),
+                range: Distance::ZERO,
+                shown: at.ground(),
+                ready: direct,
+                target_kind: Some(OrderTargetKind::of_master(target_master)),
+            };
+            let ai = self
+                .parts
+                .unit_ai
+                .get_mut(id)
+                .ok_or(GenieError::unreachable("unreachable: no unit AI"))?;
+            let _ = ai.queue_order(state, order, Dispatch::Queued, QueueEnd::Back)?;
+            if !queued && !direct {
+                readiness(&mut ai.orders, ReadyOrders::Drop);
+                // the pass's tail: the unit's stop
+                self.object_stop(q, idx)?;
+            }
+        }
+        Ok(())
+    }
+
+    /// The direct repair of the unit at `idx` of player `q` on `target` (build 188329,
+    /// `0x12c66c0`). Nothing for the unit itself or a target the world does not hold. A unit
+    /// that is neither of class `0x42` nor a repairer (masters 156 and 222) becomes its
+    /// player's repairer (slot 0x98 with 0): 156 when its master's byte reads 1 (taken here as
+    /// the task swap group, the male villagers'), else 222; nothing when the player lacks that
+    /// master. Of its master's tasks of action type `0x6a`, in list order, the first for the
+    /// target's master or class, else the last one for any target seen. When the top action
+    /// runs that task it takes the target (its slot 0x48); else the task's new Repair replaces
+    /// the unit's actions (the factory, slot 0x8c8). The unit AI is told the repair order
+    /// `0x2ce` and action `0x26a` (none of both without a task), the target with its class and
+    /// place, and its notifies are cleared (`0xd40dc0`: always below type 70, else by the
+    /// unit's `+0x69c`, which stands at 1 outside the work command).
+    pub(crate) fn repair_directly(
+        &mut self,
+        q: PlayerId,
+        idx: ListIndex,
+        target: ObjectId,
+    ) -> Result<(), GenieError> {
+        let unit = self.players.live(q, idx)?;
+        let id = unit.id;
+        if id == target {
+            return Ok(());
+        }
+        let Some((tp, t)) = self.object(target) else {
+            return Ok(());
+        };
+        let tm = t.master(self.master_tables(), tp)?;
+        let (t_class, t_master, at) = (tm.class, tm.id, t.position());
+        let own = unit.master(self.master_tables(), q)?;
+        let repairers = self.model.slots.master;
+        let (male, female) = (
+            repairers.villager_repairer_male,
+            repairers.villager_repairer_female,
+        );
+        if own.class != KEEPS_MASTER && own.id != male && own.id != female {
+            let with = if own.action_part().task_by_group == TaskGroup::MALE_VILLAGERS {
+                male
+            } else {
+                female
+            };
+            if self.model.masters.of(q).and_then(|m| m.get(with)).is_none() {
+                return Ok(());
+            }
+            self.change_master(q, idx, with)?;
+        }
+        let master = self
+            .players
+            .live(q, idx)?
+            .master(self.master_tables(), q)?;
+        let mut any = None;
+        let mut found = None;
+        for task in &master.action_part().tasks {
+            if task.action_kind != REPAIR {
+                continue;
+            }
+            if task.object_group.is_none() && task.object_id.is_none() {
+                any = Some(task);
+            }
+            if task.object_id == Some(t_master) || task.object_group == t_class.or_none() {
+                found = Some(task);
+                break;
+            }
+        }
+        let task = found.or(any).cloned();
+        let notifies = Notifies::Cleared;
+        let actions = self.parts.actions_of(id);
+        let running = (actions.top_action_kind() == Some(REPAIR))
+            .then(|| actions.list.repair().map(|r| r.task.id))
+            .flatten();
+        match task {
+            Some(task) if running == Some(task.id) => {
+                self.retake_repair(q, idx, target, at, notifies)
+            }
+            Some(task) => self.start_repair(q, idx, target, &task, at, notifies),
+            None => {
+                if let Some(ai) = self.parts.unit_ai.get_mut(id) {
+                    ai.notify_work(
+                        None,
+                        None,
+                        Some((target, t_class)),
+                        at,
+                        notifies,
+                        self.streams.get(Stream::Ai),
+                    )?;
+                }
+                Ok(())
+            }
+        }
+    }
+}
diff --git a/crates/engine/genie-core/src/unit_ai/idle_priest.rs b/crates/engine/genie-core/src/unit_ai/idle_priest.rs
new file mode 100644
index 00000000..1db1ef0e
--- /dev/null
+++ b/crates/engine/genie-core/src/unit_ai/idle_priest.rs
@@ -0,0 +1,131 @@
+//! The priest's idle check (188329 `0xcfdb10`, slot 0x240 of the priest's unit AI).
+
+use crate::GenieError;
+use crate::math::rng::Well512;
+use crate::objects::WorkerCount;
+use crate::players::PlayerKind;
+use crate::players::QueryRelation;
+use crate::players::UnitRelation;
+use crate::unit_ai::IdleOutcome;
+use crate::unit_ai::OrderKind;
+use crate::unit_ai::SurroundingFlags;
+use crate::unit_ai::UnitStance;
+use crate::unit_ai::{
+    Memory, PRIEST_CARED, Pick, Search, Surroundings, UnitAi, UnitSide, attack_search_radius,
+};
+
+impl UnitAi {
+    /// The priest's idle check (188329 `0xcfdb10`). A monk carrying a relic (class 0x2b) only
+    /// lowers its last human order time (`0xd1c2e0`, [`UnitAi::cap_human_order`]): 5.
+    ///
+    /// Any other takes the computer's way when its player is a computer (`0x1728be0`, `+0x10`
+    /// 3) or when its own unit (type 50 or above, `+0xf` above 0x31: every monk) has the byte
+    /// `+0x51c` (`0x114aaa0`) 3, or 0 outside the scenario modes (`0x13d4310`: the options'
+    /// `+0x34` 3, 4, 5 or 15), its player's `+0x648` 0 (not held, 0 for every player probed).
+    /// genie holds no `+0x51c`: the object's constructor (`0x1143b6f`) writes 0, and only a
+    /// scenario's setup and its triggers write it otherwise (`0x114bc60`'s callers), so a
+    /// human player's monk takes the computer's way outside the scenario modes. Its other way, a
+    /// human player's in a scenario mode (the cap, then a heal search within 5, or its player's
+    /// attribute 90 plus 1), is not modelled.
+    ///
+    /// The computer's way: a player that is out (`+0x89` 2, `0x1732d90`; not held, 0 for every
+    /// player probed) gives 5. The base idle check with 1 (`0xd31a30`): its slot 0x250
+    /// (`0xd38720`) retries a last order the priest's slot 0x60 (`0xd07ef0`) takes, heal or
+    /// conversion (`0x2bf`, `0x2c0`), with a `ClosestObject` of the last target's class; that
+    /// search is not modelled. Else the base's own part ([`UnitAi::tower_idle`] over
+    /// [`PRIEST_CARED`]); a 6 ends it. Then the heal: with `n` records in the enemies' list of
+    /// the last search (`0x1443caf60`, [`UnitSide::searched_count`]) above 0, an AI draw `r`
+    /// (`rand15`) and `r % 2n` up to `n` skips it. Outside `NoAttack` (stance 3) its range is its
+    /// unit's line of sight (unit slot 0x228; in `StandGround` its player's attribute 90, not
+    /// modelled); the heal search (slot 0x258, `0xcf5ad0`) first searches from its place (slot
+    /// 0x50 with mode 1, [`Pick::Look`], [`UnitAi::attack_search_alert`]), then walks the lists
+    /// ([`UnitSide::heal_target`]); an object found it heals (slot 0xe0 with 0,
+    /// `0xd27790`, [`UnitAi::work_object`]) and gives 6. Last, outside `StandGround`, the
+    /// closest enemy it reaches (`0xd22c20` with class −1, relation 2, state, master and workers
+    /// −1, reachable) it would walk away from by its range (unit slot 0x248) less their distance
+    /// (`evasiveMoveTo`, slot 0x150), which is not modelled; without one 5.
+    pub(super) fn priest_idle(
+        &mut self,
+        at: &Surroundings,
+        player_kind: PlayerKind,
+        ai: &mut Well512,
+        side: &mut dyn UnitSide,
+    ) -> Result<IdleOutcome, GenieError> {
+        if at.class.is_some_and(|c| c.get() == 0x2b) {
+            self.cap_human_order(side, ai)?;
+            return Ok(IdleOutcome::Idle);
+        }
+        if !player_kind.is_computer() && at.flags.contains(SurroundingFlags::SCENARIO) {
+            return Err(GenieError::unsupported(
+                "a human player's monk's idle check in a scenario mode (0xcfdb10)",
+            ));
+        }
+        if matches!(self.last_order, Some(OrderKind::Heal | OrderKind::Convert))
+            && self.last_target_class.is_some()
+        {
+            return Err(GenieError::unsupported(
+                "a monk's retry of its last heal or conversion (slot 0x250, 0xd38720)",
+            ));
+        }
+        let unit_ai_tuning = &at.unit_ai_tuning;
+        if self.tower_idle(at, player_kind, side, ai, &PRIEST_CARED)? == IdleOutcome::Acted {
+            return Ok(IdleOutcome::Acted);
+        }
+        let enemies = side.searched_count(UnitRelation::Enemy)?;
+        let heals = if enemies == 0 {
+            true
+        } else {
+            let n = u32::try_from(enemies).map_err(|_| {
+                GenieError::unsupported("a search that left more enemies than an int holds")
+            })?;
+            ai.rand15() % (2 * n) > n
+        };
+        if heals && self.stance != UnitStance::NoAttack {
+            if self.stance == UnitStance::StandGround {
+                return Err(GenieError::unsupported(
+                    "a StandGround monk's heal range (its player's attribute 90)",
+                ));
+            }
+            let found = side.closest(&Search {
+                at: at.position.ground(),
+                radius: attack_search_radius(at),
+                classes: &PRIEST_CARED,
+                size: at.size,
+                pick: Pick::Look,
+                memory: Memory::default(),
+            })?;
+            self.attack_search_alert(found, player_kind, unit_ai_tuning)?;
+            if side.heal_target(at.los)?.is_some() {
+                return Err(GenieError::unsupported(
+                    "a monk's heal order from its idle check (slot 0xe0)",
+                ));
+            }
+        }
+        if self.stance == UnitStance::StandGround {
+            return Ok(IdleOutcome::Idle);
+        }
+        let found = side.closest(&Search {
+            at: at.position.ground(),
+            radius: attack_search_radius(at),
+            classes: &PRIEST_CARED,
+            size: at.size,
+            pick: Pick::Closest {
+                group: None,
+                relation: Some(QueryRelation::Enemies),
+                state: None,
+                master: None,
+                workers: WorkerCount::NO_CAP,
+                spared: None,
+                reach: true,
+            },
+            memory: Memory::default(),
+        })?;
+        self.alert(found, at.dt_seconds);
+        if found.id.is_some() {
+            return Err(GenieError::unsupported(
+                "a monk's walk away from the closest enemy (unit slot 0x248, slot 0x150)",
+            ));
+        }
+        Ok(IdleOutcome::Idle)
+    }
+}
