+/// 188329 `0x1116f60` (called from the Hunt's and the Gather's `set_state(6)` for a target of class
+/// 8, 32 or 15): the unit is pulled against the resource when their tiles (truncated coordinates)
+/// differ on exactly one axis: that coordinate becomes the target's minus both radii times the
+/// whole tile difference; then the position setter (unit slot 0x60).
+pub(crate) fn snap_to_resource(
+    c: &mut crate::world::step::Step<'_>,
+    unit: &mut crate::objects::unit::Unit,
+    target: impl crate::objects::ObjectKey,
+    roles: &crate::world::layer::Roles,
+) -> Result<(), crate::GenieError> {
+    if let Some((tp, tr)) = c.w.spatial.get_known(target)?.map(|t| (t.position, t.radius)) {
+        let here = unit.place.position();
+        let dx = (tp.x() as i32) - (here.x() as i32);
+        let dy = (tp.y() as i32) - (here.y() as i32);
+        if let Some(mover) = c.w.parts.mover_mut(unit.id) {
+            let mr = mover.stats.radius;
+            let at = if dx != 0 && dy == 0 {
+                Some(crate::map::Position::new(tp.x() - (mr.x() + tr.x()) * dx as f32, here.y(), here.z()))
+            } else if dx == 0 && dy != 0 {
+                Some(crate::map::Position::new(here.x(), tp.y() - (mr.y() + tr.y()) * dy as f32, here.z()))
+            } else {
+                None
+            };
+            if let Some(at) = at {
+                let at = mover.set_position(at, c.w.spatial.map, &c.w.model.tuning.movement);
+                let at = mover.grounded(at, c.w.spatial.terrain.as_ref());
+                mover.mark_move(at, c.w.world_time);
+                mover.new_position(
+                    &mut unit.place,
+                    unit.id,
+                    at,
+                    (&mut c.w.spatial, Some(&mut c.w.pathing)),
+                    roles,
+                    c.w.model.tuning.visibility,
+                )?;
+            }
+        }
+    }
+    Ok(())
+}
