+    /// `toward` to the building `i` of player `p` for a unit of master `made` and leaves it for
+    /// the next spawn search ([`super::search::SPAWN_PATH`]); the caller clears it after.
+    pub(crate) fn spawn_path_set(
+        &mut self,
+        p: PlayerId,
+        i: ListIndex,
+        made: &crate::objects::masters::Master,
+        toward: Option<crate::map::Point>,
+    ) -> Result<(), GenieError> {
+        // 188329 spawn search, step 7: the tile path from the gather point to the building
+        if std::env::var_os("GENIE_EXPERIMENT_SPAWN_188329").is_some() {
+            let mut points: Option<Vec<(f32, f32)>> = None;
+            if let (Some(g), Some(moving)) = (toward, made.move_stats) {
+                let hx = self.players.live(p, i)?.master(self.master_tables(), p)?.radius.x();
