+        }
+    }
+    let mut n = 0;
+    loop {
+        if n >= rings {
+            // step 13: after the last ring the rings run again by distance alone
+            if steps2.take().is_some() {
+                n = 0;
+                continue;
+            }
+            break;
+        }
+        let ring = n;
+        n += 1;
+        let n = ring;
+        let (dx, dy) = if n < out_rings {
