@@ -27,6 +27,8 @@ pub struct Task {
     /// `+0xe`: the action the task makes the unit do.
     pub action_kind: ActionKind,
     /// `+0x10`: the target class the task is for, none (−1) for any.
+    #[serde(with = "signed_task_group")]
+    #[cfg_attr(feature = "schema", schemars(with = "Option<i16>"))]
     pub object_group: Option<ClassId>,
     /// `+0x12`: the target master, -1 for any.
     pub object_id: Option<MasterId>,
@@ -111,3 +113,20 @@ impl Default for Task {
         }
     }
 }
+
+
+/// Cache representation for task groups only: preserve the three observed opaque
+/// negative groups without weakening ClassId's ordinary validation.
+mod signed_task_group {
+    use super::ClassId;
+    use serde::{Deserialize, Deserializer, Serialize, Serializer};
+    pub fn serialize<S: Serializer>(v: &Option<ClassId>, s: S) -> Result<S::Ok, S::Error> {
+        v.map(ClassId::get).serialize(s)
+    }
+    pub fn deserialize<'de, D: Deserializer<'de>>(d: D) -> Result<Option<ClassId>, D::Error> {
+        Option::<i16>::deserialize(d)?.map(|v| {
+            if matches!(v, -1288 | -1256 | -1448) { Ok(ClassId::of_master(v)) }
+            else { ClassId::try_from(v).map_err(serde::de::Error::custom) }
+        }).transpose()
+    }
+}
