diff --git a/crates/engine/genie-core/src/commands/repair.rs b/crates/engine/genie-core/src/commands/repair.rs
new file mode 100644
index 00000000..4308cf7c
--- /dev/null
+++ b/crates/engine/genie-core/src/commands/repair.rs
@@ -0,0 +1,46 @@
+//! REPAIR (0x6e): a player's units told to repair an object.
+
+use crate::GenieError;
+use crate::commands::UnitList;
+use crate::objects::ObjectId;
+use crate::players::PlayerId;
+use crate::world::World;
+
+/// REPAIR (0x6e; build 188329: `do_command`'s case `0xf60e04`, handler `0xf653d0`): the units
+/// of the packet repair the object `target` ([`World::repair_units`]).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RepairCommand {
+    /// The player.
+    pub player: PlayerId,
+    /// The object to repair (`+0x8`), none for the packet's -1.
+    pub target: Option<ObjectId>,
+    /// The units told to repair it (the count at `+0x4`, the ids from `+0x10`).
+    pub units: UnitList,
+    /// `+0xe`: queued (a unit with a unit AI takes it as an order at the end of its queue).
+    pub queued: bool,
+    /// `+0xf`: direct (a unit takes it at once even while its unit AI holds an order not ready;
+    /// an order it queues is ready).
+    pub direct: bool,
+    /// The packet's bytes `+0x6..+0x8` and `+0xc..+0xe`, which nothing reads; kept so that the
+    /// command writes back as it was recorded.
+    pub gaps: [[u8; 2]; 2],
+}
+
+impl RepairCommand {
+    /// `do_command`'s case (`0xf60e04`) checks the units as BUILD's does (a count past the
+    /// packet's ids refuses it, [`World::read_units`]; another player's become -1 and a human's
+    /// command left without one is refused, [`World::command_check`]); then the handler
+    /// ([`World::repair_units`]).
+    pub(crate) fn run(&self, w: &mut World) -> Result<(), GenieError> {
+        let Some(listed) = w.read_units(self.player, &self.units) else {
+            return Ok(());
+        };
+        let Some(units) = w.command_check(self.player, listed)? else {
+            return Ok(());
+        };
+        let Some(target) = self.target else {
+            return Ok(());
+        };
+        w.repair_units(&units, target, (self.queued, self.direct))
+    }
+}
diff --git a/crates/engine/genie-core/src/correction.rs b/crates/engine/genie-core/src/correction.rs
new file mode 100644
index 00000000..235e801f
--- /dev/null
+++ b/crates/engine/genie-core/src/correction.rs
@@ -0,0 +1,296 @@
+//! Correction mode (`GENIE_CORRECT=1`, research): the simulation is pulled back to what a
+//! recording says of the original game where it says it.
+//!
+//! - A unit id an order names that the commanding player does not hold is read as the player's
+//!   nearest unclaimed id (within [`ID_REACH`]): the object ids drift when the simulation makes
+//!   objects (a carcass, its blood) at other times than the game did. The pairs found are kept,
+//!   and a target id takes a kept pair too.
+//! - An order's or a gather point's target that moves is put at the point the packet names: the
+//!   game writes the target's place there when the player clicks it.
+//!
+//! Every correction prints a `CORRECT_ID` or `CORRECT_POS` line to stderr.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::{Mutex, OnceLock};
+
+use crate::commands::Command;
+use crate::map::Position;
+use crate::movement::MoveState;
+use crate::objects::ObjectId;
+use crate::orders::Interact;
+use crate::players::PlayerId;
+use crate::world::World;
+use crate::world::index::Place;
+use crate::world::slots::PlayerSlots;
+
+/// How far from a recorded id the simulation's id may lie.
+pub const ID_REACH: i32 = 4;
+
+/// The least distance a target is put back over.
+const SNAP_LEAST: f32 = 0.01;
+
+#[derive(Default)]
+struct Ids {
+    /// Recorded id -> the simulation's id.
+    map: HashMap<i32, i32>,
+    /// The simulation's ids a recorded id already stands for (itself or another).
+    claimed: HashSet<i32>,
+    /// Recorded ids an order named while the simulation held them for its player: one gone
+    /// since died in the simulation, and is not read as another.
+    seen: HashSet<(usize, i32)>,
+}
+
+fn ids() -> &'static Mutex<Ids> {
+    static IDS: OnceLock<Mutex<Ids>> = OnceLock::new();
+    IDS.get_or_init(|| Mutex::new(Ids::default()))
+}
+
+/// Whether the correction mode is on (`GENIE_CORRECT`).
+#[must_use]
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("GENIE_CORRECT").is_some())
+}
+
+/// Whether the mode puts targets back (`GENIE_CORRECT` not `ids`).
+fn snaps() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("GENIE_CORRECT").as_deref() != Ok("ids"))
+}
+
+/// A recorded id the commanding player holds stands for itself.
+pub fn claim(player: PlayerId, id: Option<ObjectId>) {
+    if enabled()
+        && let Some(id) = id
+        && let Ok(mut ids) = ids().lock()
+    {
+        let _ = ids.claimed.insert(id.get());
+        let _ = ids.seen.insert((player.index(), id.get()));
+    }
+}
+
+/// The simulation's id for recorded unit id `id` of `player`'s order, none for none found.
+pub fn unit_id(w: &World, player: PlayerId, id: Option<ObjectId>) -> Option<ObjectId> {
+    unit_id_of(w, player, id, Kind::Any)
+}
+
+/// What a list names: units, buildings, or either (a target).
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Kind {
+    Units,
+    Buildings,
+    Any,
+}
+
+/// [`unit_id`] for a list of `kind`: a candidate of the other kind does not count.
+pub(crate) fn unit_id_of(
+    w: &World,
+    player: PlayerId,
+    id: Option<ObjectId>,
+    kind: Kind,
+) -> Option<ObjectId> {
+    use crate::objects::masters::MasterKind;
+    let id = id?;
+    let Ok(mut ids) = ids().lock() else {
+        return None;
+    };
+    let held = |x: i32| {
+        ObjectId::of_field(x)
+            .and_then(|o| w.place(o))
+            .is_some_and(|p| p.player() == player)
+    };
+    if let Some(&to) = ids.map.get(&id.get())
+        && held(to)
+    {
+        return ObjectId::of_field(to);
+    }
+    if ids.seen.contains(&(player.index(), id.get())) {
+        return None;
+    }
+    let objects = &w.players.player(player).ok()?.objects;
+    let mut best: Option<i32> = None;
+    for u in objects {
+        let x = u.id.get();
+        let d = (x - id.get()).abs();
+        if d == 0 || ID_REACH < d || ids.claimed.contains(&x) {
+            continue;
+        }
+        let building = u
+            .master(w.master_tables(), player)
+            .is_ok_and(|m| m.kind == MasterKind::BUILDING);
+        if (kind == Kind::Units && building) || (kind == Kind::Buildings && !building) {
+            continue;
+        }
+        best = match best {
+            Some(b) if (b - id.get()).abs() < d || ((b - id.get()).abs() == d && b < x) => Some(b),
+            _ => Some(x),
+        };
+    }
+    let to = best?;
+    let _ = ids.map.insert(id.get(), to);
+    let _ = ids.claimed.insert(to);
+    eprintln!(
+        "CORRECT_ID world_ms={} player={} recorded={} sim={to}",
+        w.world_time.millis(),
+        player.index(),
+        id.get()
+    );
+    ObjectId::of_field(to)
+}
+
+/// A target id: its kept pair, else itself.
+fn target_id(id: Option<ObjectId>) -> Option<ObjectId> {
+    let id = id?;
+    ids()
+        .lock()
+        .ok()
+        .and_then(|ids| ids.map.get(&id.get()).copied())
+        .and_then(ObjectId::of_field)
+        .or(Some(id))
+}
+
+impl World {
+    /// The command as the correction mode runs it: its units' ids and its target's read as the
+    /// simulation's ([`unit_id`], [`World::target_of`]), then an order's or a gather point's
+    /// target put at the packet's point.
+    pub(crate) fn correct_command(&mut self, command: &Command) -> Command {
+        use crate::commands::UnitList;
+        let mut command = command.clone();
+        let fix_of = |w: &World, player: PlayerId, list: &mut UnitList, kind: Kind| {
+            if list.names_last_commanded() {
+                return;
+            }
+            for slot in &mut list.ids {
+                let held = slot.and_then(|id| w.place(id)).is_some_and(|p| p.player() == player);
+                if held {
+                    claim(player, *slot);
+                } else if slot.is_some() {
+                    if let Some(to) = unit_id_of(w, player, *slot, kind) {
+                        *slot = Some(to);
+                    }
+                }
+            }
+        };
+        let fix = |w: &World, player: PlayerId, list: &mut UnitList| {
+            fix_of(w, player, list, Kind::Units);
+        };
+        match &mut command {
+            Command::Order(c) => {
+                fix(self, c.player, &mut c.units);
+                if let crate::commands::Order::Interact(Interact { target, .. }) = &mut c.order {
+                    *target = self.target_of(c.player, *target);
+                }
+            }
+            Command::Build(c) => fix(self, c.player, &mut c.builders),
+            Command::BuildWall(c) => fix(self, c.player, &mut c.builders),
+            Command::GatherPoint(c) => {
+                fix(self, c.player, &mut c.units);
+                c.target = self.target_of(c.player, c.target);
+            }
+            Command::SetGatherState(c) => fix(self, c.player, &mut c.units),
+            Command::Queue(c) => fix_of(self, c.player, &mut c.buildings, Kind::Buildings),
+            Command::CommandQueue(c) => {
+                fix(self, c.player, &mut c.units);
+                c.target = self.target_of(c.player, c.target);
+            }
+            Command::GoBackToWork(c) => {
+                if let Some(to) = self.target_of(c.player, Some(c.id)) {
+                    c.id = to;
+                }
+            }
+            Command::Unload(c) => fix(self, c.player, &mut c.units),
+            Command::AutoScout(c) => fix(self, c.player, &mut c.units),
+            Command::Stop(c) => fix(self, c.player, &mut c.units),
+            Command::Patrol(c) => fix(self, c.player, &mut c.units),
+            Command::AttackMove(c) => fix(self, c.player, &mut c.units),
+            Command::SeekShelter(c) => fix(self, c.player, &mut c.units),
+            Command::UnitAiState(c) => fix(self, c.player, &mut c.units),
+            Command::FormFormation(c) => fix(self, c.player, &mut c.units),
+            Command::UnitOrder(c) => {
+                fix(self, c.player, &mut c.units);
+                c.target = self.target_of(c.player, c.target);
+            }
+            _ => {}
+        }
+        if snaps() {
+            match &command {
+                Command::Order(c) => {
+                    if let crate::commands::Order::Interact(Interact { target, point, .. }) =
+                        &c.order
+                    {
+                        self.snap(*target, point.x(), point.y());
+                    }
+                }
+                Command::GatherPoint(c) => self.snap(c.target, c.point.x(), c.point.y()),
+                _ => {}
+            }
+        }
+        command
+    }
+
+    /// A target id as the simulation holds it: a kept pair's; one the world does not hold
+    /// read as the commanding player's nearest unclaimed id ([`unit_id`], a foundation made at
+    /// another id); else itself.
+    fn target_of(&self, player: PlayerId, id: Option<ObjectId>) -> Option<ObjectId> {
+        let kept = target_id(id);
+        if kept != id {
+            return kept;
+        }
+        match id {
+            Some(t) if self.place(t).is_none() => unit_id(self, player, id).or(id),
+            _ => id,
+        }
+    }
+
+    /// A live object that moves goes to (x, y), keeping its height.
+    fn snap(&mut self, id: Option<ObjectId>, x: f32, y: f32) {
+        let Some(id) = id else { return };
+        let Some(Place::Live(p, i)) = self.place(id) else {
+            return;
+        };
+        let moves = self
+            .parts
+            .mover_of(id)
+            .is_some_and(|m| 0.0 < m.stats.speed.get());
+        if !moves || !(0.0..1e5).contains(&x) || !(0.0..1e5).contains(&y) {
+            return;
+        }
+        let moving = MoveState::of_mover(self.parts.mover_of(id));
+        let now = self.world_time;
+        let Ok(unit) = self.players.live_mut(p, i) else {
+            return;
+        };
+        if unit.life.inside.is_some() {
+            return;
+        }
+        let here = unit.position();
+        let (dx, dy) = (x - here.x(), y - here.y());
+        if (dx * dx + dy * dy).sqrt() < SNAP_LEAST {
+            return;
+        }
+        let at = Position::new(x, y, here.z());
+        if unit
+            .new_position(
+                at,
+                moving,
+                (&mut self.spatial, Some(&mut self.pathing)),
+                &self.model.roles,
+                self.model.tuning.visibility,
+            )
+            .is_err()
+        {
+            return;
+        }
+        if let Some(m) = self.parts.mover_mut(id) {
+            m.mark_move(at, now);
+        }
+        eprintln!(
+            "CORRECT_POS world_ms={} id={} from=({:.3},{:.3}) to=({x:.3},{y:.3}) d={:.3}",
+            now.millis(),
+            id.get(),
+            here.x(),
+            here.y(),
+            (dx * dx + dy * dy).sqrt()
+        );
+    }
+}
diff --git a/crates/engine/genie-core/src/gain_trace.rs b/crates/engine/genie-core/src/gain_trace.rs
new file mode 100644
index 00000000..307fdcd4
--- /dev/null
+++ b/crates/engine/genie-core/src/gain_trace.rs
@@ -0,0 +1,193 @@
+//! DIAGNOSTIC (`GENIE_TRACE_GAIN`): what each player's units gave their player at drop-offs,
+//! split by where the load came from, for the census tool's `GAIN` lines. The simulation never
+//! reads it: the hooks only write here, and only when the switch is set.
+//!
+//! A unit's load is a list of (source, amount) pieces, added whenever its held amount grows
+//! (the Gather's and the Hunt's work, by the target's class and master). A drop-off splits the
+//! amount given by those pieces; a civilization's additional resources of the load count under
+//! the load's largest source.
+
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+
+/// The sources, in the order of a total's columns: herdable (class 58), predator animal (class
+/// 10: boar), prey animal (class 9: deer), berry bush (class 7), farm (class 49), fish (classes
+/// 5 and 33, and the fish trap, master 199), tree (class 15), mine (classes 32 and 8), other.
+pub const SOURCES: usize = 9;
+
+/// A player's totals: `[resource][source]`, the resources food, wood, stone, gold (the
+/// attributes 0 to 3).
+pub type Totals = [[f64; SOURCES]; 4];
+
+#[derive(Default)]
+struct State {
+    loads: HashMap<i32, Vec<(usize, f32)>>,
+    last: HashMap<i32, usize>,
+    totals: Vec<Totals>,
+    /// The animal pieces of a unit's load: (target id, amount), beside `loads` (which stays as
+    /// it was, so the totals do not change by a bit).
+    animal_loads: HashMap<i32, Vec<(i32, f32)>>,
+    animals: std::collections::BTreeMap<i32, Animal>,
+}
+
+/// An animal (sources 0 to 2: herdable, boar, deer) units took food from: its master and class,
+/// the update time of the first gain, what was taken from it (`gathered`, at the gain) and what
+/// each player was given of it at drop-offs (`given`, index = player number; without the
+/// additional resources of a load).
+#[derive(Clone, Debug, Default)]
+pub struct Animal {
+    /// The target's master.
+    pub master: i16,
+    /// The target's class.
+    pub class: i16,
+    /// The sum of the gains from it.
+    pub gathered: f64,
+    /// What each player was given of it.
+    pub given: Vec<f64>,
+    /// Its full food: its master's first storage amount, as the first gain from it saw it (what
+    /// it had when it became a resource; `full - gathered` is what was left to rot or remains).
+    pub full: f64,
+}
+
+fn enabled() -> bool {
+    static FLAG: OnceLock<bool> = OnceLock::new();
+    *FLAG.get_or_init(|| std::env::var_os("GENIE_TRACE_GAIN").is_some())
+}
+
+fn state() -> &'static Mutex<State> {
+    static STATE: OnceLock<Mutex<State>> = OnceLock::new();
+    STATE.get_or_init(|| Mutex::new(State::default()))
+}
+
+const fn source(class: i16, master: i16) -> usize {
+    match class {
+        58 => 0,
+        10 => 1,
+        9 => 2,
+        7 => 3,
+        49 => {
+            if master == 199 {
+                5
+            } else {
+                4
+            }
+        }
+        5 | 33 => 5,
+        15 => 6,
+        32 | 8 => 7,
+        _ => 8,
+    }
+}
+
+/// Unit `unit`'s load grew by `gain` from target `target` of `master` and `class` (`full`: the
+/// target master's first storage amount); `held` is its load
+/// after it (a load that is all this gain starts anew).
+pub fn grew(unit: i32, target: i32, master: i16, class: i16, full: f32, gain: f32, held: f32) {
+    if !enabled() {
+        return;
+    }
+    let Ok(mut s) = state().lock() else { return };
+    let from = source(class, master);
+    {
+        let pieces = s.animal_loads.entry(unit).or_default();
+        if held <= gain + 1e-4 {
+            pieces.clear();
+        }
+        if from <= 2 {
+            match pieces.iter_mut().find(|p| p.0 == target) {
+                Some(p) => p.1 += gain,
+                None => pieces.push((target, gain)),
+            }
+        }
+    }
+    if from <= 2 {
+        let a = s.animals.entry(target).or_default();
+        a.master = master;
+        a.class = class;
+        if a.full == 0.0 {
+            a.full = f64::from(full);
+        }
+        a.gathered += f64::from(gain);
+    }
+    let _ = s.last.insert(unit, from);
+    let load = s.loads.entry(unit).or_default();
+    if held <= gain + 1e-4 {
+        load.clear();
+    }
+    match load.iter_mut().find(|p| p.0 == from) {
+        Some(p) => p.1 += gain,
+        None => load.push((from, gain)),
+    }
+}
+
+/// Unit `unit` of player `player` gave its player `amount` of attribute `kind`; `extra`: an
+/// additional resource of the load just given.
+pub fn dropped(player: usize, unit: i32, kind: i16, amount: f32, extra: bool) {
+    if !enabled() || !(0..4).contains(&kind) {
+        return;
+    }
+    let Ok(mut s) = state().lock() else { return };
+    let resource = kind as usize;
+    if s.totals.len() <= player {
+        s.totals.resize(player + 1, [[0.0; SOURCES]; 4]);
+    }
+    if extra {
+        let from = s.last.get(&unit).copied().unwrap_or(SOURCES - 1);
+        s.totals[player][resource][from] += f64::from(amount);
+        return;
+    }
+    let load = s.loads.remove(&unit).unwrap_or_default();
+    let whole: f32 = load.iter().map(|p| p.1).sum();
+    let pieces = s.animal_loads.remove(&unit).unwrap_or_default();
+    if 0.0 < whole {
+        for &(target, part) in &pieces {
+            let a = s.animals.entry(target).or_default();
+            if a.given.len() <= player {
+                a.given.resize(player + 1, 0.0);
+            }
+            a.given[player] += f64::from(amount) * f64::from(part) / f64::from(whole);
+        }
+    }
+    if whole <= 0.0 {
+        let from = s.last.get(&unit).copied().unwrap_or(SOURCES - 1);
+        s.totals[player][resource][from] += f64::from(amount);
+        return;
+    }
+    let mut most = (SOURCES - 1, 0.0f32);
+    for &(from, part) in &load {
+        s.totals[player][resource][from] += f64::from(amount) * f64::from(part) / f64::from(whole);
+        if most.1 < part {
+            most = (from, part);
+        }
+    }
+    let _ = s.last.insert(unit, most.0);
+}
+
+/// Player `player` got `amount` of attribute `kind` from a generating task (a relic's gold, a
+/// trickle): source "other".
+pub fn generated(player: usize, kind: i16, amount: f32) {
+    if !enabled() || !(0..4).contains(&kind) {
+        return;
+    }
+    let Ok(mut s) = state().lock() else { return };
+    if s.totals.len() <= player {
+        s.totals.resize(player + 1, [[0.0; SOURCES]; 4]);
+    }
+    s.totals[player][kind as usize][SOURCES - 1] += f64::from(amount);
+}
+
+/// Every player's totals so far (index = player number; players that gave nothing may be
+/// missing).
+#[must_use]
+pub fn totals() -> Vec<Totals> {
+    state().lock().map(|s| s.totals.clone()).unwrap_or_default()
+}
+
+/// Every animal food was taken from so far, by its object id.
+#[must_use]
+pub fn animals() -> Vec<(i32, Animal)> {
+    state()
+        .lock()
+        .map(|s| s.animals.iter().map(|(k, v)| (*k, v.clone())).collect())
+        .unwrap_or_default()
+}
diff --git a/crates/engine/genie-core/src/gathering/extra.rs b/crates/engine/genie-core/src/gathering/extra.rs
new file mode 100644
index 00000000..d2a51e54
--- /dev/null
+++ b/crates/engine/genie-core/src/gathering/extra.rs
@@ -0,0 +1,111 @@
+//! 188329's "additional resource" tasks (task type 164, `0xa4`): a civilization bonus that pays a
+//! second resource for what a gatherer gathers (Danes: food on food; Varangians: gold on meat;
+//! Portuguese: wood on berries). The game's unit holds a table of its master's type-164 tasks
+//! (`0x12b71f0`: the resource `+0x24`, a key, `work_val1` and the player's attribute `+0x22`) and
+//! a map from resource to amount; each gain of the load (`0x113e4d0`, slot 0x110 with its flag 1)
+//! adds `(gain × work_val1) × attribute` to the map for each entry whose key is the target's
+//! master, the target's class plus 900 or -1; a drop-off gives the load, then each map entry, and
+//! clears the map (Hunt `0xbb78eb` to `0xbb7947`, Gather `0xb81e77` to `0xb81edc`); a load of
+//! another kind clears it too (`0xbb5d03`, `0xb7f905`). Research finding 51.
+
+use crate::GenieError;
+use crate::objects::masters::ActionKind;
+use crate::objects::masters::ClassId;
+use crate::objects::masters::Master;
+use crate::objects::masters::MasterId;
+use crate::players::Amount;
+use crate::players::attribute::AttributeId;
+
+/// The task type of an additional resource (164).
+const ADDITIONAL_RESOURCE: ActionKind = ActionKind::named(0xa4);
+/// What the game adds to a class to make its key (`0x384`).
+const CLASS_KEY: i32 = 900;
+/// The rules a gatherer's reads hold at most.
+const MOST: usize = 4;
+
+/// One type-164 task as the game's table holds it (`0x12b71f0`, 16 bytes).
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct ExtraRule {
+    /// `+0`: the resource it pays (the task's `+0x24`).
+    resource: AttributeId,
+    /// `+4`: the task's class plus 900, else its master, else -1.
+    key: i32,
+    /// `+8`: the task's `work_val1`.
+    share: f32,
+    /// `+0xc`: the player's attribute the task's `+0x22` names. The game copies it when it
+    /// builds the table (the unit's setup and refresh); here it is read as the update starts.
+    scale: f32,
+}
+
+/// A gatherer's master's type-164 tasks, in the tasks' order; none for most masters.
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct ExtraRules {
+    /// How many of `rules` are set.
+    count: usize,
+    /// The rules.
+    rules: [Option<ExtraRule>; MOST],
+}
+
+impl ExtraRules {
+    /// The rules of `master` for a player whose attributes are `attributes`.
+    ///
+    /// # Errors
+    ///
+    /// A master with more type-164 tasks than the reads hold.
+    pub(crate) fn of(master: &Master, attributes: &[Amount]) -> Result<Self, GenieError> {
+        let mut out = Self::default();
+        for t in &master.action_part().tasks {
+            if t.action_kind != ADDITIONAL_RESOURCE {
+                continue;
+            }
+            // a task without a resource pays none
+            let Some(resource) = t.attribute_kind3 else {
+                continue;
+            };
+            let key = match (t.object_group, t.object_id) {
+                (Some(class), _) => i32::from(class.get()) + CLASS_KEY,
+                (None, Some(master)) => i32::from(i16::from(master)),
+                (None, None) => -1,
+            };
+            let scale = (t.attribute_kind2)
+                .and_then(|i| attributes.get(i.index()))
+                .map_or(0.0, |a| a.get());
+            let slot = out.rules.get_mut(out.count).ok_or(GenieError::unsupported(
+                "a master with more than four additional resource tasks (type 164)",
+            ))?;
+            *slot = Some(ExtraRule {
+                resource,
+                key,
+                share: t.work_val1.get(),
+                scale,
+            });
+            out.count += 1;
+        }
+        Ok(out)
+    }
+
+    /// A gain `gain` of the load from a target of `master` and `class` (`0x113e523` to
+    /// `0x113e589`): each matching rule adds `(gain × share) × scale` to its resource's amount in
+    /// `extra`, in `f32` and in that order.
+    pub(crate) fn gain(
+        &self,
+        extra: &mut Vec<(AttributeId, Amount)>,
+        gain: Amount,
+        master: MasterId,
+        class: ClassId,
+    ) {
+        let by_master = i32::from(i16::from(master));
+        let by_class = i32::from(class.get()) + CLASS_KEY;
+        for r in self.rules.iter().flatten() {
+            if r.key != by_master && r.key != by_class && r.key != -1 {
+                continue;
+            }
+            let add = (gain.get() * r.share) * r.scale;
+            if let Some(e) = extra.iter_mut().find(|e| e.0 == r.resource) {
+                e.1 = Amount::new(add + e.1.get());
+            } else {
+                extra.push((r.resource, Amount::new(add + 0.0)));
+            }
+        }
+    }
+}
diff --git a/crates/engine/genie-core/src/groups/formation/lapjv.rs b/crates/engine/genie-core/src/groups/formation/lapjv.rs
new file mode 100644
index 00000000..d3591e84
--- /dev/null
+++ b/crates/engine/genie-core/src/groups/formation/lapjv.rs
@@ -0,0 +1,575 @@
+//! 188329's formation slot assignment (findings 135): the integer cost rows of `0x10d4a50` and
+//! the Jonker–Volgenant solver `0x10d29d0` it calls, ported line for line from the disassembly
+//! (`re-kit/re/out_r31/r31c_d.c`, `r31c_e.c`; every comparison checked against the instructions).
+//!
+//! Both routines work on one block of process globals (BSS, all 0 as the process starts),
+//! modelled here as one flat `i32` array, [`Lapjv::mem`], at the game's own offsets from
+//! `0x144365360`:
+//!
+//! | offset (cells) | address        | what                                   |
+//! |----------------|----------------|----------------------------------------|
+//! | [`COST`]       | `0x144365360`  | the costs, 120 × 120, row = member     |
+//! | [`ROWSOL`]     | `0x144373460`  | each row's column (member → slot)      |
+//! | [`COLSOL`]     | `0x144373640`  | each column's row                      |
+//! | [`V`]          | `0x144373820`  | the column prices                      |
+//! | [`FREE`]       | `0x144373a00`  | the free rows                          |
+//! | [`COLLIST`]    | `0x144373be0`  | the columns to scan                    |
+//! | [`MATCHES`]    | `0x144373dc0`  | how often a row was a column's minimum |
+//! | [`D`]          | `0x144373fa0`  | the shortest path distances            |
+//! | [`PRED`]       | `0x144374180`  | each column's predecessor row          |
+//!
+//! What stays from one call to the next (and so must live as long as the match, shared by every
+//! group of every player): the cost rows of members the world does not hold (never rewritten),
+//! the cost rows a call wrote before an early return, and `rowsol` past the matrix size (read
+//! for members beyond the slot count). The solver itself fills everything it reads for
+//! `n <= 120`.
+//!
+//! All integer arithmetic wraps as the 32-bit instructions do.
+
+/// The side of the game's arrays: the solver does nothing for a size above it (`cmp ebp, 0x78;
+/// ja` at `0x10d29de`, unsigned).
+pub const SIDE: usize = 120;
+/// Cells of the cost matrix (`0x144365360`..`0x144373460`).
+pub const CELLS: usize = SIDE * SIDE;
+/// Offsets (in `i32` cells from `0x144365360`) of the globals, see the crate docs.
+pub const COST: usize = 0;
+/// `0x144373460`.
+pub const ROWSOL: usize = CELLS;
+/// `0x144373640`.
+pub const COLSOL: usize = ROWSOL + SIDE;
+/// `0x144373820`.
+pub const V: usize = COLSOL + SIDE;
+/// `0x144373a00`.
+pub const FREE: usize = V + SIDE;
+/// `0x144373be0`.
+pub const COLLIST: usize = FREE + SIDE;
+/// `0x144373dc0`.
+pub const MATCHES: usize = COLLIST + SIDE;
+/// `0x144373fa0`.
+pub const D: usize = MATCHES + SIDE;
+/// `0x144374180`.
+pub const PRED: usize = D + SIDE;
+/// `0x144374360`: past the block (what lies there is not modelled).
+pub const END: usize = PRED + SIDE;
+
+/// The cost of a slot a member may not take (`mov eax, 0xf4240`).
+pub const BARRED: i32 = 1_000_000;
+/// The scale of the squared distance (`[0x14369ffb4]` = 100.0f).
+pub const SCALE: f32 = 100.0;
+/// The solver's "infinity" (`0x7fffffff`).
+const BIG: i32 = i32::MAX;
+
+/// What `0x10d4a50` reads of one slot in use (188329 slot, 0x3c bytes).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SlotAsk {
+    /// `+0x14`: the slot's place x (the transform place's x).
+    pub x: f32,
+    /// `+0x18`: the slot's place y (the map's y; the transform place's third component).
+    pub y: f32,
+    /// `+0x34 != 0 && +0x38 != 0` (the slot is active and transformed).
+    pub usable: bool,
+    /// `+0x2c`: the desired sub-formation, -1 for any.
+    pub category: i32,
+    /// `+0x30`: the desired master (unit type), -1 for any.
+    pub master: i32,
+}
+
+/// What `0x10d4a50` reads of one member the world holds (`0x141616cf0` found it).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct MemberAsk {
+    /// Vtable slot 0x560 (`0x113c4a0`, a copy of `+0x3bc`..`+0x3c8`): component 0, the x of the
+    /// unit's place (not where it last moved to).
+    pub x: f32,
+    /// The same vector's component 2: the map's y.
+    pub y: f32,
+    /// `0x10d9790(unit, 0)`: its sub-formation (158041 `FUN_141011300`).
+    pub category: i32,
+    /// Its master id, read as a 16-bit value and sign-extended (`movsx ecx, ax` at `0x10d4bdd`).
+    pub master: i32,
+}
+
+/// How a call of `0x10d4a50` ended.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Populate {
+    /// The solver ran (or returned at once for a size above 120): each member index in order
+    /// with the slot index `rowsol` holds for it. Every member of the list takes one, held by the
+    /// world or not; the index may be stale (rows at or past the slot count) and may point at a
+    /// spare slot of the array. Apply in order: `slot[s].unit = member; slot[s].+0x28 = 1`.
+    Assigned(Vec<(usize, i32)>),
+    /// A member the world holds met a formation of no slots (`cmp [rbp+4], 0; jle` at
+    /// `0x10d4af6`): nothing assigned; earlier rows stay written.
+    NoSlots,
+    /// A member the world holds had no slot it could take (all 1,000,000 from the "bad" path or
+    /// the master path; `test dil, dil` at `0x10d4c8e`): nothing assigned; its row and the
+    /// earlier rows stay written.
+    MemberWithoutSlot,
+}
+
+/// A cell index past the modelled block (the game would write or read whatever follows).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct OutOfRange(pub u64);
+
+/// x86 `cvttss2si` to a 32-bit register: truncation, and `0x80000000` for NaN or out of range
+/// (Rust's `as` saturates instead).
+#[must_use]
+pub fn cvttss2si(v: f32) -> i32 {
+    if v.is_nan() || v >= 2_147_483_648.0 || v < -2_147_483_648.0 {
+        i32::MIN
+    } else {
+        v as i32
+    }
+}
+
+/// `0x10d4a50`'s cost of member `u` at slot `s` when neither barred: the squared ground gap
+/// times 100, in the instructions' order (`0x10d4c42`..`0x10d4c67`):
+/// `cvttss2si(((uy - sy)² + (ux - sx)²) * 100.0f)`, all f32.
+#[must_use]
+pub fn cell_cost(u: &MemberAsk, s: &SlotAsk) -> i32 {
+    let dy = u.y - s.y; // xmm1 = [rax+8] - [slot+0x18]
+    let dx = u.x - s.x; // xmm0 = [rax]   - [slot+0x14]
+    let sum = dy * dy + dx * dx; // mulss xmm1,xmm1; mulss xmm0,xmm0; addss xmm1,xmm0
+    cvttss2si(sum * SCALE) // mulss xmm1,xmm6; cvttss2si
+}
+
+/// The process globals of `0x10d4a50`/`0x10d29d0`. One per match (process), shared by every
+/// group of every player; all 0 at the start ([`Lapjv::default`]).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Lapjv {
+    /// The block from `0x144365360` to `0x144374360`, see the crate docs.
+    pub mem: Vec<i32>,
+}
+
+impl Default for Lapjv {
+    fn default() -> Self {
+        Self { mem: vec![0; END] }
+    }
+}
+
+impl Lapjv {
+    /// A cell of the block by a (non-negative) index the game computes.
+    fn at(&self, i: i64) -> i32 {
+        self.mem[usize::try_from(i).expect("negative cell index")]
+    }
+
+    /// Writes a cell.
+    fn put(&mut self, i: i64, v: i32) {
+        self.mem[usize::try_from(i).expect("negative cell index")] = v;
+    }
+
+    /// The cost cell `i` (row-major, row = member).
+    #[must_use]
+    pub fn cost(&self, i: usize) -> i32 {
+        self.mem[COST + i]
+    }
+
+    /// `rowsol[i]`: member (row) `i`'s slot (column).
+    #[must_use]
+    pub fn rowsol(&self, i: usize) -> i32 {
+        self.mem[ROWSOL + i]
+    }
+
+    /// `0x10d4a50` without the solver and the assignment: the cost rows of `members` (in the
+    /// group's order, `+0xf0`, `+0xe4` of them; None for one the world does not hold) over
+    /// `slots` (the formation's slots in use, `+0x10`, `+0x4` of them). On `Ok(None)` the caller
+    /// goes on to the solver of size `slots.len()`; `Ok(Some(..))` is an early return.
+    ///
+    /// # Errors
+    ///
+    /// A row index past the modelled block (members × slots above about 15,000).
+    pub fn slot_costs(
+        &mut self,
+        members: &[Option<MemberAsk>],
+        slots: &[SlotAsk],
+    ) -> Result<Option<Populate>, OutOfRange> {
+        let n_slots = slots.len() as i32; // [rbp+4]
+        let count = members.len() as u32; // [rdx+0xe4], unsigned loop (`jb` at 0x10d4cbb)
+        let mut m: u32 = 0;
+        while m < count {
+            if let Some(u) = members[m as usize] {
+                if n_slots < 1 {
+                    return Ok(Some(Populate::NoSlots));
+                }
+                let mut any = false; // [rsp+0xb0]
+                let mut s: i32 = 0;
+                while s < n_slots {
+                    let slot = &slots[s as usize];
+                    // +0x38 == 0 || +0x34 == 0
+                    let mut bad = !slot.usable;
+                    // 0x10d9790 runs for every slot; -1 takes any
+                    if slot.category != -1 && u.category != slot.category {
+                        bad = true;
+                    }
+                    // eax = m * S + s, 32-bit, zero-extended into the address
+                    let cell = m.wrapping_mul(n_slots as u32).wrapping_add(s as u32);
+                    let value = if slot.master == -1 || u.master == slot.master {
+                        if bad {
+                            BARRED
+                        } else {
+                            any = true;
+                            cell_cost(&u, slot)
+                        }
+                    } else {
+                        BARRED
+                    };
+                    if u64::from(cell) >= END as u64 {
+                        return Err(OutOfRange(u64::from(cell)));
+                    }
+                    self.mem[COST + cell as usize] = value;
+                    s += 1;
+                }
+                if !any {
+                    return Ok(Some(Populate::MemberWithoutSlot));
+                }
+            }
+            m += 1;
+        }
+        // rows count..S-1 are 0 (unsigned `jae` at 0x10d4cd5)
+        let mut r = count;
+        while r < n_slots as u32 {
+            let mut c: i32 = 0;
+            while c < n_slots {
+                let cell = (n_slots as u32).wrapping_mul(r).wrapping_add(c as u32);
+                if u64::from(cell) >= END as u64 {
+                    return Err(OutOfRange(u64::from(cell)));
+                }
+                self.mem[COST + cell as usize] = 0;
+                c += 1;
+            }
+            r += 1;
+        }
+        Ok(None)
+    }
+
+    /// `0x10d4a50` (`param_1` the formation, `param_2` the group): [`Lapjv::slot_costs`], the
+    /// solver of size `slots.len()` ([`Lapjv::solve`]), then each member `i` in order takes
+    /// slot `rowsol[i]` (read as `movsxd` from `0x144373460 + 4 i`, past the 120 entries into the
+    /// following arrays as the game would).
+    ///
+    /// The game's caller clears every slot's unit and `+0x28` first (`0x110d690`, the engine's
+    /// `Formation::clear_units`).
+    ///
+    /// # Errors
+    ///
+    /// As [`Lapjv::slot_costs`].
+    pub fn populate(
+        &mut self,
+        members: &[Option<MemberAsk>],
+        slots: &[SlotAsk],
+    ) -> Result<Populate, OutOfRange> {
+        if let Some(early) = self.slot_costs(members, slots)? {
+            return Ok(early);
+        }
+        self.solve(slots.len() as i32);
+        let count = members.len() as i32; // `cmp dword [rsi+0xe4], 0; jle`, signed
+        let mut out = Vec::new();
+        let mut i: i32 = 0;
+        while i < count {
+            let cell = ROWSOL as u64 + i as u64;
+            if cell >= END as u64 {
+                return Err(OutOfRange(cell));
+            }
+            out.push((i as usize, self.mem[cell as usize]));
+            i += 1;
+        }
+        Ok(Populate::Assigned(out))
+    }
+
+    /// `0x10d29d0`: Jonker–Volgenant on the `n` × `n` costs at [`COST`] (cell `n * row + col`),
+    /// the result in `rowsol` / `colsol`. Line for line with the instructions; the comments
+    /// name the classic `lap.cpp` steps and the addresses.
+    #[allow(clippy::too_many_lines)]
+    pub fn solve(&mut self, n: i32) {
+        // movsxd rbp, ecx; cmp ebp, 0x78; ja -> return (so negative sizes return too)
+        if (n as u32) > 0x78 {
+            return;
+        }
+        let nl = i64::from(n);
+        let cost = |s: &Self, i: i32| s.at(COST as i64 + i64::from(i));
+        // memset(matches, 0, 4 n) when n > 0
+        if n > 0 {
+            for k in 0..n as usize {
+                self.mem[MATCHES + k] = 0;
+            }
+        }
+
+        // ---- COLUMN REDUCTION (0x10d2a5b..0x10d2b56): j from n-1 down to 0
+        let mut j: i32 = n - 1;
+        while j >= 0 {
+            let mut min: i32 = BIG;
+            let mut imin: i64 = 0;
+            let mut i: i32 = 0;
+            while i64::from(i) < nl {
+                let c = cost(self, n.wrapping_mul(i).wrapping_add(j));
+                // cmp ecx, r8d; cmovge keeps the old: a new minimum only when strictly less
+                if c < min {
+                    min = c;
+                    imin = i64::from(i);
+                }
+                i += 1;
+            }
+            let m = self.at(MATCHES as i64 + imin);
+            self.put(V as i64 + i64::from(j), min);
+            if m == 0 {
+                self.put(ROWSOL as i64 + imin, j);
+                self.put(COLSOL as i64 + i64::from(j), imin as i32);
+            } else {
+                let old = i64::from(self.at(ROWSOL as i64 + imin));
+                // cmp r8d, [v + old]; jge -> unassigned
+                if min < self.at(V as i64 + old) {
+                    self.put(COLSOL as i64 + i64::from(j), imin as i32);
+                    self.put(COLSOL as i64 + old, -1);
+                    self.put(ROWSOL as i64 + imin, j);
+                } else {
+                    self.put(COLSOL as i64 + i64::from(j), -1);
+                }
+            }
+            self.put(MATCHES as i64 + imin, m.wrapping_add(1));
+            j -= 1;
+        }
+
+        // ---- REDUCTION TRANSFER (0x10d2b5c..0x10d2bf2)
+        let mut numfree: i32 = 0;
+        {
+            let mut row_base: i32 = 0; // esi, += n per row
+            let mut i: i64 = 0;
+            while i < nl {
+                let m = self.at(MATCHES as i64 + i);
+                if m == 0 {
+                    self.put(FREE as i64 + i64::from(numfree), i as i32);
+                    numfree += 1;
+                } else if m == 1 {
+                    let j1 = i64::from(self.at(ROWSOL as i64 + i));
+                    let mut min: i32 = BIG;
+                    let mut k: i64 = 0;
+                    let mut cell = row_base;
+                    while k < nl {
+                        if k != j1 {
+                            let h = cost(self, cell).wrapping_sub(self.at(V as i64 + k));
+                            if h < min {
+                                min = h;
+                            }
+                        }
+                        k += 1;
+                        cell += 1;
+                    }
+                    let vj = self.at(V as i64 + j1);
+                    self.put(V as i64 + j1, vj.wrapping_sub(min));
+                }
+                row_base = row_base.wrapping_add(n);
+                i += 1;
+            }
+        }
+
+        // ---- AUGMENTING ROW REDUCTION, twice (0x10d2c00..0x10d2d4f)
+        let mut pass: i64 = 2;
+        loop {
+            let prvnumfree = i64::from(numfree);
+            numfree = 0;
+            let mut write: i64 = 0; // r12: the next place of the new free list
+            let mut k: i64 = 0; // r15
+            if prvnumfree > 0 {
+                loop {
+                    let i = self.at(FREE as i64 + k);
+                    let k_here = k;
+                    k += 1;
+                    let mut umin: i32 = BIG; // r10
+                    let mut usubmin: i32 = BIG; // r9
+                    let mut j1: i64 = 0; // rbp / esi
+                    let mut j2: i64 = 0; // rbx / r11
+                    let row = n.wrapping_mul(i);
+                    let mut jj: i64 = 0;
+                    while jj < nl {
+                        let h = cost(self, row.wrapping_add(jj as i32))
+                            .wrapping_sub(self.at(V as i64 + jj));
+                        // cmp eax, r9d; jge skip
+                        if h < usubmin {
+                            // cmp eax, r10d; jl -> new minimum
+                            if h >= umin {
+                                usubmin = h;
+                                j2 = jj;
+                            } else {
+                                usubmin = umin;
+                                j2 = j1;
+                                umin = h;
+                                j1 = jj;
+                            }
+                        }
+                        jj += 1;
+                    }
+                    let mut i0 = self.at(COLSOL as i64 + j1);
+                    if umin < usubmin {
+                        let vj = self.at(V as i64 + j1);
+                        self.put(V as i64 + j1, vj.wrapping_add(umin.wrapping_sub(usubmin)));
+                    } else if i0 > -1 {
+                        i0 = self.at(COLSOL as i64 + j2);
+                        j1 = j2;
+                    }
+                    self.put(ROWSOL as i64 + i64::from(i), j1 as i32);
+                    self.put(COLSOL as i64 + j1, i);
+                    if i0 > -1 {
+                        if umin < usubmin {
+                            // free[--k] = i0
+                            k = k_here;
+                            self.put(FREE as i64 + k_here, i0);
+                        } else {
+                            self.put(FREE as i64 + write, i0);
+                            write += 1;
+                            numfree += 1;
+                        }
+                    }
+                    if k >= prvnumfree {
+                        break;
+                    }
+                }
+            }
+            pass -= 1;
+            if pass == 0 {
+                break;
+            }
+        }
+
+        // ---- AUGMENTATION, one shortest path per free row (0x10d2d55..0x10d3084)
+        let mut f: i64 = 0;
+        while f < i64::from(numfree) {
+            let freerow = self.at(FREE as i64 + f);
+            if n - 1 >= 0 {
+                for c in 0..n as usize {
+                    self.mem[PRED + c] = freerow; // rep stosd
+                }
+                let base = n.wrapping_mul(freerow);
+                let mut jj: i32 = n - 1;
+                while jj >= 0 {
+                    self.put(COLLIST as i64 + i64::from(jj), jj);
+                    let dj = cost(self, base.wrapping_add(jj))
+                        .wrapping_sub(self.at(V as i64 + i64::from(jj)));
+                    self.put(D as i64 + i64::from(jj), dj);
+                    jj -= 1;
+                }
+            }
+            let mut low: i64 = 0; // r13d / rsi
+            let mut up: i64 = 0; // edi
+            let mut last: i64 = 0; // [rsp+0x28]
+            let mut min: i32 = 0; // r8d
+            let endofpath: i32 = 'search: loop {
+                if up == low {
+                    // scan up..n-1 for the new minimum (0x10d2e40..0x10d2eba)
+                    last = low - 1;
+                    let first = self.at(COLLIST as i64 + up);
+                    up += 1;
+                    min = self.at(D as i64 + i64::from(first));
+                    let mut kk = up;
+                    while kk < nl {
+                        let jc = self.at(COLLIST as i64 + kk);
+                        let h = self.at(D as i64 + i64::from(jc));
+                        // cmp eax, r8d; jg skip
+                        if h <= min {
+                            if h < min {
+                                up = low;
+                            }
+                            let moved = self.at(COLLIST as i64 + up);
+                            self.put(COLLIST as i64 + kk, moved);
+                            self.put(COLLIST as i64 + up, jc);
+                            up += 1;
+                            // cmovge: min stays when h >= min
+                            if h < min {
+                                min = h;
+                            }
+                        }
+                        kk += 1;
+                    }
+                    // an unassigned column among the minima ends the path at once
+                    let mut kk = low;
+                    while kk < up {
+                        let jc = self.at(COLLIST as i64 + kk);
+                        if self.at(COLSOL as i64 + i64::from(jc)) < 0 {
+                            break 'search jc;
+                        }
+                        kk += 1;
+                    }
+                }
+                // scan the next column of the minimum (0x10d2ef4..0x10d2f2f)
+                let j1 = self.at(COLLIST as i64 + low);
+                low += 1;
+                let i = self.at(COLSOL as i64 + i64::from(j1));
+                let row = n.wrapping_mul(i);
+                let h = cost(self, row.wrapping_add(j1))
+                    .wrapping_sub(self.at(V as i64 + i64::from(j1)))
+                    .wrapping_sub(min);
+                // cmp edi, ebx; jge -> back to the top
+                if up >= nl {
+                    continue;
+                }
+                let mut kk = up;
+                while kk < nl {
+                    let jc = self.at(COLLIST as i64 + kk);
+                    let v2 = cost(self, row.wrapping_add(jc))
+                        .wrapping_sub(self.at(V as i64 + i64::from(jc)))
+                        .wrapping_sub(h);
+                    // cmp r11d, [d + j]; jge skip
+                    if v2 < self.at(D as i64 + i64::from(jc)) {
+                        self.put(PRED as i64 + i64::from(jc), i);
+                        if v2 == min {
+                            if self.at(COLSOL as i64 + i64::from(jc)) < 0 {
+                                break 'search jc;
+                            }
+                            let moved = self.at(COLLIST as i64 + up);
+                            self.put(COLLIST as i64 + kk, moved);
+                            self.put(COLLIST as i64 + up, jc);
+                            up += 1;
+                        }
+                        self.put(D as i64 + i64::from(jc), v2);
+                    }
+                    kk += 1;
+                }
+            };
+            // column prices: k from last + 1 (one more than lap.cpp's `last`; that column's
+            // d equals min, so it adds 0) down to 0 (0x10d2ff0..0x10d3033)
+            let mut kk = last + 1;
+            while kk >= 0 {
+                let jc = i64::from(self.at(COLLIST as i64 + kk));
+                let add = self.at(D as i64 + jc).wrapping_sub(min);
+                let vj = self.at(V as i64 + jc);
+                self.put(V as i64 + jc, vj.wrapping_add(add));
+                kk -= 1;
+            }
+            // the alternating path back to the free row (0x10d3040..0x10d3069)
+            let mut jc = endofpath;
+            loop {
+                let i = self.at(PRED as i64 + i64::from(jc));
+                self.put(COLSOL as i64 + i64::from(jc), i);
+                let next = self.at(ROWSOL as i64 + i64::from(i));
+                self.put(ROWSOL as i64 + i64::from(i), jc);
+                jc = next;
+                if i == freerow {
+                    break;
+                }
+            }
+            f += 1;
+        }
+    }
+}
+
+/// `0x10d4a50`'s cost rows from all-zero globals, as a vector of `max(members, slots)` rows of
+/// `slots.len()` cells (row = member); None for the early returns ([`Populate::NoSlots`],
+/// [`Populate::MemberWithoutSlot`]). A stateless view for tests and tracing: the engine must use
+/// a persistent [`Lapjv`] (see the crate docs).
+#[must_use]
+pub fn slot_costs(members: &[Option<MemberAsk>], slots: &[SlotAsk]) -> Option<Vec<i32>> {
+    let mut l = Lapjv::default();
+    match l.slot_costs(members, slots) {
+        Ok(None) => {
+            let rows = members.len().max(slots.len());
+            Some(l.mem[..rows * slots.len()].to_vec())
+        }
+        _ => None,
+    }
+}
+
+/// [`Lapjv::solve`] of a square matrix on fresh globals: each row's column.
+#[must_use]
+pub fn solve_matrix(costs: &[i32], n: usize) -> Vec<i32> {
+    let mut l = Lapjv::default();
+    l.mem[..n * n].copy_from_slice(&costs[..n * n]);
+    l.solve(n as i32);
+    (0..n).map(|i| l.rowsol(i)).collect()
+}
