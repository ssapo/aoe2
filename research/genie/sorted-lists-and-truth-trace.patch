+    let bit = match class {
+        6 | 9 | 10 | 28 | 29 | 35 | 45 | 46 | 50 | 56 | 58 | 61 | 65 => 0,
+        12 | 24 | 47 | 57 => 1,
+        0 | 44 => 2,
+        23 | 36 => 3,
+        17 | 18 | 43 => 4,
+        4 | 19 | 59 | 66 => 5,
+        2 | 20 | 21 | 22 | 53 => 6,
+        13 | 51 | 54 | 55 | 68 => 7,
+        3 | 27 | 39 | 49 | 52 | 60 | 67 => 8,
+        _ => return false,
+    };
+    flags >> bit & 1 != 0
+}
