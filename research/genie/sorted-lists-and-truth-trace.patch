@@ -0,0 +1,77 @@
+//! Prints the effect commands of the techs named on the command line (a diagnosis tool).
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mut args = std::env::args().skip(1);
+    let bytes = std::fs::read(args.next().unwrap())?;
+    let d = genie_dat::de::DatFile::read_from(&bytes[..])?;
+    for a in args {
+        let (kind, n) = a.split_at(1);
+        let n: usize = n.parse()?;
+        if kind == "s" {
+            // every effect command on attribute n of a unit or class, with the techs that use the effect
+            for (ei, e) in d.effects.iter().enumerate() {
+                for c in &e.commands {
+                    if matches!(c.kind, 0 | 4 | 5 | 10 | 14 | 15) && c.c as usize == n {
+                        let techs: Vec<String> = d.techs.iter().enumerate().filter(|(_, t)| t.effect_id as usize == ei && t.effect_id >= 0).map(|(i, t)| format!("{i}:{}:civ{}:req{:?}", String::from_utf8_lossy(&t.name.bytes), t.civ, t.required_techs)).collect();
+                        println!("effect {ei} {:?} kind={} a={} b={} d={} techs={:?}", String::from_utf8_lossy(&e.name.bytes), c.kind, c.a, c.b, c.d, techs);
+                    }
+                }
+            }
+            continue;
+        }
+        if kind == "c" {
+            // every tech of civ n, in full
+            for (i, t) in d.techs.iter().enumerate() {
+                if t.civ as usize == n && t.civ >= 0 {
+                    println!("tech {i} {:?}: {t:?}", String::from_utf8_lossy(&t.name.bytes));
+                    if t.effect_id >= 0 {
+                        for c in &d.effects[t.effect_id as usize].commands {
+                            println!("    kind={} a={} b={} c={} d={}", c.kind, c.a, c.b, c.c, c.d);
+                        }
+                    }
+                }
+            }
+            continue;
+        }
+        if kind == "u" {
+            // every effect command on unit n (kinds 0, 4, 5, 10, 14, 15), with the techs that use the effect
+            for (ei, e) in d.effects.iter().enumerate() {
+                for c in &e.commands {
+                    if matches!(c.kind, 0 | 4 | 5 | 10 | 14 | 15) && c.a as usize == n {
+                        let techs: Vec<String> = d.techs.iter().enumerate().filter(|(_, t)| t.effect_id as usize == ei && t.effect_id >= 0).map(|(i, t)| format!("{i}:{}", String::from_utf8_lossy(&t.name.bytes))).collect();
+                        println!("effect {ei} {:?} kind={} a={} b={} c={} d={} techs={:?}", String::from_utf8_lossy(&e.name.bytes), c.kind, c.a, c.b, c.c, c.d, techs);
+                    }
+                }
+            }
+            continue;
+        }
+        if kind == "f" {
+            println!("tech {n}: {:?}", d.techs[n]);
+            continue;
+        }
+        if kind == "r" {
+            for (i, t) in d.techs.iter().enumerate() {
+                if t.required_techs.contains(&(n as i16)) {
+                    println!("tech {i} {:?} civ={} effect={} required={:?} need={} time={:?} locs={:?}", String::from_utf8_lossy(&t.name.bytes), t.civ, t.effect_id, t.required_techs, t.required_tech_count, t.queue_time, t.research_location_count);
+                    if t.effect_id >= 0 {
+                        for c in &d.effects[t.effect_id as usize].commands {
+                            println!("    kind={} a={} b={} c={} d={}", c.kind, c.a, c.b, c.c, c.d);
+                        }
+                    }
+                }
+            }
+            continue;
+        }
+        let e = if kind == "t" {
+            let t = &d.techs[n];
+            println!("tech {n} {:?} civ={} effect={} required={:?}", t.name, t.civ, t.effect_id, t.required_techs);
+            if t.effect_id < 0 { continue; }
+            t.effect_id as usize
+        } else { n };
+        let e = &d.effects[e];
+        println!(" effect {:?}", e.name);
+        for c in &e.commands {
+            println!("  kind={} a={} b={} c={} d={}", c.kind, c.a, c.b, c.c, c.d);
+        }
+    }
+    Ok(())
+}
