+    /// EXPERIMENT (188329): the list in ascending id order, as the running game's live list reads
+    /// (ground-truth memory log, 2026-11-10). Nothing moves while an object is out for its update.
+    pub fn sort_by_id(&mut self) {
+        if self.outs.is_empty() {
+            self.units.sort_by_key(|u| u.id);
+        }
+    }
+
+    /// EXPERIMENT (188329): `unit` goes where its id puts it in ascending order; the ones after
+    /// it move down a slot, the stand-ins' slots with them. Returns its slot.
+    pub fn insert_by_id(&mut self, unit: Unit) -> ListIndex {
+        let id = unit.id;
+        let mut at = self.units.len();
+        for (i, u) in self.units.iter().enumerate() {
+            let held = if u.id == TAKEN_OUT {
+                self.outs.iter().find(|o| o.1.get() == i).map(|o| o.0)
+            } else {
+                Some(u.id)
+            };
+            if held.is_some_and(|h| h > id) {
+                at = i;
+                break;
+            }
+        }
+        self.units.insert(at, unit);
+        for o in self.outs.iter_mut().filter(|o| o.1.get() >= at) {
+            o.1 = ListIndex::new(o.1.get() + 1);
+        }
+        ListIndex::new(at)
+    }
+
