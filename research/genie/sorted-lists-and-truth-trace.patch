+                    let req = crate::pathing::tile_path::Request {
+                        from: g,
+                        to: self.players.live(p, i)?.position().ground(),
+                        radii: crate::map::Distance::new(hx),
+                        range: crate::map::Distance::ZERO,
+                        closed: Vec::new(),
+                        full: true,
+                    };
