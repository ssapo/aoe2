+//! 188329's `commandHorde` (`0x10d86e0`..`0x10d8e60`; finding 55), behind
+//! `GENIE_EXPERIMENT_HORDE_188329`: a group without a formation unit does not move as a
+//! formation; each member gets the ordinary work command and a copy of one path planned from
+//! the lead, and the group goes on its next awake update.
+
+use crate::GenieError;
+use crate::groups::GroupCommandKind;
+use crate::groups::GroupFlags;
+use crate::groups::GroupId;
+use crate::groups::GroupMove;
+use crate::groups::GroupTarget;
+use crate::map::Distance;
+use crate::map::Point;
+use crate::math::fmath::BVector;
+use crate::movement::FuturePath;
+use crate::objects::ObjectId;
+use crate::orders::OrderSource;
+use crate::orders::Work;
+use crate::pathing::tile_path::{Path, Request};
+use crate::world::Seconds;
+use crate::world::World;
+use crate::world::slots::PlayerSlots;
+
+impl World {
+    /// 188329 `commandHorde` (`0x10d86e0`) of group `group`: the target data resets, every
+    /// member's seconds since attacking are the largest float, and the lead is the member
+    /// nearest (0, 0, 0) (`0x10dc850` after the reset); without one the group only gets flag
+    /// 0x40 (not begun). Else the target data is set (a target's range is `range` + 2.0), one
+    /// path is planned from the lead to `point` (`0x1057a40`: radii = the target's radius + the
+    /// lead master's, range `range`, the full search unless the lead's player is a computer),
+    /// and every member the world holds takes its points as future path data (slot 0x590: from
+    /// point 0 for the lead, from point 1 for the others, only with more than one point) and the
+    /// ordinary work command (slot 0x138 at height 1.0, direct). The group's current command is
+    /// `command` and flag 0x40 is set: begun.
+    ///
+    /// # Errors
+    ///
+    /// A lead without a tile planner (`0x1078d60`, not read), and what the work command does
+    /// not model.
+    pub(super) fn command_horde(
+        &mut self,
+        group: GroupId,
+        command: GroupCommandKind,
+        target: Option<ObjectId>,
+        point: Point,
+        range: Distance,
+    ) -> Result<GroupMove, GenieError> {
+        let target = target.filter(|&t| self.object(t).is_some());
+        let g = self.groups.held_mut(group)?;
+        g.forget_target_data();
+        g.current_target.range = Distance::ZERO;
+        g.current_target.certain_action = None;
+        for m in &mut g.members {
+            m.seconds_since_attacking = Seconds::MAX;
+        }
+        let lead = self.nearest_to_target(group);
+        self.groups.held_mut(group)?.motion.lead = lead;
+        let g = self.groups.held(group)?;
+        let held = self.lead_object(&g.motion).is_some();
+        let Some((lead, (lp, lu))) = lead
+            .filter(|_| held)
+            .and_then(|id| self.object(id).map(|o| (id, o)))
+        else {
+            self.groups.held_mut(group)?.flags |= GroupFlags::NO_PATH_UNIT;
+            return Ok(GroupMove::NotBegun);
+        };
+        let from = lu.position().ground();
+        let master = lu.master(self.master_tables(), lp)?;
+        let (lead_radius, restriction) = (master.radius.x(), master.terrain_restriction);
+        let full = !self.players.player(lp)?.kind.is_computer();
+        match target {
+            None => {
+                let t = &mut self.groups.held_mut(group)?.current_target;
+                t.target = GroupTarget::None;
+                t.original_position = BVector::new(point.x(), 0.0, point.y());
+                t.range = range;
+                t.target_radius = Distance::ZERO;
+                t.disable_retargeting = 0;
+                t.certain_action = None;
+            }
+            Some(o) => {
+                self.raise_attack_ranges(group, o)?;
+                let at = self.moved_place_of(o)?;
+                let radius = self.target_radius(o)?;
+                let t = &mut self.groups.held_mut(group)?.current_target;
+                t.target = GroupTarget::Object(o);
+                t.original_position = at;
+                t.range = Distance::new(range.get() + 2.0);
+                t.target_radius = radius;
+                t.disable_retargeting = 0;
+                t.certain_action = None;
+            }
+        }
+        let target_radius = self.groups.held(group)?.current_target.target_radius;
+        let req = Request {
+            from,
+            to: point,
+            radii: Distance::new(target_radius.get() + lead_radius),
+            range,
+            closed: Vec::new(),
+            full,
+        };
+        let mut path = Path::default();
+        let tiles = self.spatial.tiles();
+        let Some(planner) = restriction.and_then(|r| self.pathing.planner(r, tiles)) else {
+            return Err(GenieError::unsupported(
+                "a horde's path without a tile planner (188329 0x1078d60)",
+            ));
+        };
+        let _ = planner.plan::<GenieError>(&req, false, &mut path, None, &self.model.tuning.tile_path)?;
+        let ids: Vec<ObjectId> = self
+            .groups
+            .held(group)?
+            .members
+            .iter()
+            .map(|m| m.id)
+            .collect();
+        for id in ids {
+            if self.world_object(id).is_none() {
+                continue;
+            }
+            let skip = usize::from(id != lead);
+            let points: Vec<BVector> = path.points.get(skip..).unwrap_or(&[]).to_vec();
+            if 1 < points.len()
+                && let Some(m) = self.parts.mover_mut(id)
+            {
+                m.future = Some(FuturePath { points });
+            }
+            self.give_work(
+                id,
+                &Work {
+                    target,
+                    point: point.with_height(1.0),
+                    carry_test: false,
+                    filter: None,
+                    source: OrderSource::Direct,
+                },
+            )?;
+        }
+        let g = self.groups.held_mut(group)?;
+        g.current_command = command;
+        g.flags |= GroupFlags::NO_PATH_UNIT;
+        Ok(GroupMove::Begun)
+    }
+}
diff --git a/crates/engine/genie-core/src/groups/merge.rs b/crates/engine/genie-core/src/groups/merge.rs
new file mode 100644
index 00000000..e8b44cf1
--- /dev/null
+++ b/crates/engine/genie-core/src/groups/merge.rs
@@ -0,0 +1,133 @@
+//! The world's merge of a command's groups (188329 `0x162a8f0`): one tick after an order split
+//! its units into several groups, the groups that stand together and do the same take each
+//! other in.
+
+use crate::GenieError;
+use crate::groups::GroupCommandKind;
+use crate::groups::GroupId;
+use crate::groups::UnitGroup;
+use crate::objects::ObjectId;
+use crate::objects::masters::ActionKind;
+use crate::world::World;
+use crate::world::slots::PlayerSlots;
+
+/// A group on this command (a garrison, `0x2713`) takes no other in.
+const GARRISON: GroupCommandKind = GroupCommandKind::named(0x2713);
+/// Two groups merge only nearer than this on the ground, squared (`DAT_14369ff64`, 1.0).
+const MERGE_REACH_SQUARED: f32 = 1.0;
+/// Where the owner breaks formations by speed, two groups whose top speeds differ by more than
+/// this stay apart (`DAT_14408ea98`, 0.2).
+const MERGE_SPEED_GAP: f32 = 0.2;
+/// A group takes another in only while both have at most this many members together (`0x3c`).
+const MERGE_MOST: usize = 60;
+/// The action types (`0x7c`, `0x7d`) a member's top action keeps its group from merging
+/// (`0x10d28f0`).
+const UNMERGED_ACTIONS: [ActionKind; 2] = [ActionKind::named(0x7c), ActionKind::named(0x7d)];
+
+impl World {
+    /// 188329 `0x162a8f0`, which the world update runs right after the commands (`0x1628552`,
+    /// after `do_commands` `0xf52d70`) and before any group updates (findings 164). Each group of
+    /// the world's list, in order, with members and not on a garrison command (`+0x3b0` not
+    /// `0x2713`), goes through its differentiator groups (`+0x108`, count `+0x110`) in order; one
+    /// that is not itself and that the world holds (an id the world does not hold the game sets
+    /// to −1, `0x10f6460`, which no reader tells from a gone id: ids are never given twice) is
+    /// taken in when:
+    /// - the owner breaks formations by speed (player `+0x5f8` 1) only: the groups' top speeds
+    ///   (`+0xbc`) differ by at most [`MERGE_SPEED_GAP`] (`COMISS`, `JA`: a NaN gap merges);
+    /// - their places (`+8`) are nearer than 1 on the ground (`(dx² + 0) + dy²` below 1.0;
+    ///   `COMISS`, `JBE`: a NaN does not merge);
+    /// - they do the same ([`same_commands`], `0x10d2820`);
+    /// - no member of either is on a top action of type `0x7c` or `0x7d` (`0x10d28f0`);
+    /// - neither hibernates (`+0x13c`);
+    /// - their members are at most 60 together (else the game only logs).
+    ///
+    /// Then each member of the other, its first in turn, joins the group (`AddUnit` `0x10d3c50`
+    /// with −1 and 0, [`World::add_to_group`], which takes it out of the other); a first member
+    /// that stays first after a second join ends the loop (the game logs it). The group then
+    /// votes its formation type ([`World::calc_formation_kind`], `0x10d4ff0`). The emptied group
+    /// stays in the list; its own update deletes it.
+    ///
+    /// # Errors
+    ///
+    /// What the joins and the vote do not model.
+    pub(crate) fn merge_groups(&mut self) -> Result<(), GenieError> {
+        let order: Vec<GroupId> = self.groups.groups.iter().map(|g| g.id).collect();
+        for id in order {
+            let Some(group) = self.groups.get(id) else {
+                continue;
+            };
+            if group.members.is_empty() || group.current_command == GARRISON {
+                continue;
+            }
+            let others = group.differentiator_groups.clone();
+            for other in others {
+                if other == id || !self.merges(id, other)? {
+                    continue;
+                }
+                let mut last: Option<ObjectId> = None;
+                while let Some(first) = self.groups.held(other)?.members.first().map(|m| m.id) {
+                    let _ = self.add_to_group(id, first)?;
+                    if last == Some(first) {
+                        break;
+                    }
+                    last = Some(first);
+                }
+                self.calc_formation_kind(id)?;
+            }
+        }
+        Ok(())
+    }
+
+    /// Whether group `id` takes group `other` in ([`World::merge_groups`]'s tests): false for an
+    /// `other` the world does not hold, and for two groups past 60 members together.
+    fn merges(&self, id: GroupId, other: GroupId) -> Result<bool, GenieError> {
+        let group = self.groups.held(id)?;
+        let Some(that) = self.groups.get(other) else {
+            return Ok(false);
+        };
+        let formations = self.players.player(group.owner_player()?)?.formations;
+        let gap = (group.motion.maximum_velocity_forward.get()
+            - that.motion.maximum_velocity_forward.get())
+        .abs();
+        if formations.by_speed && MERGE_SPEED_GAP < gap {
+            return Ok(false);
+        }
+        let (a, b) = (group.motion.position[0], that.motion.position[0]);
+        let (dx, dy) = (a.x() - b.x(), a.y() - b.y());
+        let reach = dx * dx + 0.0 + dy * dy;
+        if !(reach < MERGE_REACH_SQUARED) {
+            return Ok(false);
+        }
+        Ok(same_commands(group, that)
+            && !self.on_unmerged_action(group)
+            && !self.on_unmerged_action(that)
+            && group.hibernating == 0
+            && that.hibernating == 0
+            && group.members.len() + that.members.len() <= MERGE_MOST)
+    }
+
+    /// `0x10d28f0`: some member of `group` the world holds as a unit is on a top action of type
+    /// `0x7c` or `0x7d`.
+    fn on_unmerged_action(&self, group: &UnitGroup) -> bool {
+        group.members.iter().any(|m| {
+            self.object(m.id).is_some()
+                && self
+                    .parts
+                    .actions_of(m.id)
+                    .top_action_kind()
+                    .is_some_and(|k| UNMERGED_ACTIONS.contains(&k))
+        })
+    }
+}
+
+/// `0x10d2820`: two groups do the same: the same current command (`+0x3b0`), the same number of
+/// queued commands (`+0x460`) and, in order, the same command and target in each (the queue at
+/// `+0x430`).
+fn same_commands(a: &UnitGroup, b: &UnitGroup) -> bool {
+    a.current_command == b.current_command
+        && a.command_queue.len() == b.command_queue.len()
+        && a.command_queue
+            .iter()
+            .zip(&b.command_queue)
+            .all(|(x, y)| x.command == y.command && x.target_id == y.target_id)
+}
diff --git a/crates/engine/genie-core/src/objects/convert.rs b/crates/engine/genie-core/src/objects/convert.rs
