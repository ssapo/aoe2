+thread_local! {
+    /// EXPERIMENT (188329 spawn path mode): the tile planner's path from the gather point to the
+    /// building's centre, set by the caller around [`spawn_point_188329`].
+    pub static SPAWN_PATH: std::cell::RefCell<Option<Vec<(f32, f32)>>> = const { std::cell::RefCell::new(None) };
+}
+
+/// EXPERIMENT (`GENIE_EXPERIMENT_SPAWN_188329`): the spawn point as build 188329 finds it
+/// (`0x1288c20`). A grid of tiles two around the building holds each tile's steps (`passable`
+/// tiles only, four ways) from the ring of tiles beside the building and the passable tiles under
+/// it. Rings of candidates lie around the building: the unit's radius plus a hundredth out, then
+/// one step (twice the radius plus 1e-4) further each, as many as fit in two tiles; then the same
+/// rings inward. Each ring walks its low-y side from high x down, its high-x side up, its high-y
+/// side from low x up and its low-x side down. A candidate counts on a tile fewer than three
+/// steps away where the placement `test` is free. The first ring with candidates gives the one
+/// nearest the gather point (the first made of equals; without a gather point, the point left of
+/// and above the building by the radii).
+///
+/// Not modelled: with a tile path of two points or more from the building to the gather point
+/// the game orders the candidates first by their tiles' steps from the path's last point but one
+/// (`0x12796a0`), and skips a ring whose best cannot be reached from it.
+pub fn spawn_point_188329(
+    site: &Site,
+    unit: Footprint,
+    test: &mut dyn FnMut(Point) -> Result<Tested, GenieError>,
+    passable: &dyn Fn(i32, i32) -> bool,
+) -> Result<Point, GenieError> {
+    let (cx, cy) = (site.position.x(), site.position.y());
+    let (hx, hy) = (site.radius.x(), site.radius.y());
+    let (rx, ry) = (unit.x(), unit.y());
+    let (x0, y0, x1, y1) = (cx - hx, cy - hy, hx + cx, hy + cy);
+    let wide = ((x1 - x0) + 0.999) as i64 as u32;
+    let high = ((y1 - y0) + 0.999) as i64 as u32;
+    let least = wide.min(high);
+    let grid_w = wide.max(1) + 4;
+    let grid_h = high.max(1) + 4;
+    let (oxf, oyf) = (x0 - 2.0, y0 - 2.0);
+    let (ox, oy) = (oxf as i32, oyf as i32);
+    let (lx, ly) = ((x0 - 1.0) as i64 as u32 as i32, (y0 - 1.0) as i64 as u32 as i32);
+    let (tx, ty) = (x1 as i64 as u32 as i32, y1 as i64 as u32 as i32);
+    let mut steps = vec![10000_i16; (grid_w * grid_h) as usize];
+    let mut queue: std::collections::VecDeque<(u16, u16, i16)> = std::collections::VecDeque::new();
+    let mut seed = |q: &mut std::collections::VecDeque<(u16, u16, i16)>, x: i32, y: i32| {
+        if passable(x, y) {
+            q.push_back(((x - ox) as u16, (y - oy) as u16, 0));
+        }
+    };
+    if passable(lx + 1, ly) || passable(lx, ly + 1) {
+        seed(&mut queue, lx, ly);
+    }
+    for x in lx + 1..tx {
+        seed(&mut queue, x, ly);
+    }
+    if passable(tx - 1, ly) || passable(tx, ly + 1) {
+        seed(&mut queue, tx, ly);
+    }
+    for y in ly + 1..ty {
+        seed(&mut queue, tx, y);
+    }
+    if passable(tx - 1, ty) || passable(tx, ty - 1) {
+        seed(&mut queue, tx, ty);
+    }
+    for x in lx + 1..tx {
+        seed(&mut queue, x, ty);
+    }
+    if passable(lx + 1, ty) || passable(lx, ty - 1) {
+        seed(&mut queue, lx, ty);
+    }
+    for y in ly + 1..ty {
+        seed(&mut queue, lx, y);
+    }
+    for y in ly + 1..ty {
+        for x in lx + 1..tx {
+            seed(&mut queue, x, y);
+        }
+    }
+    while let Some((gx, gy, d)) = queue.pop_front() {
+        let i = (u32::from(gx) + u32::from(gy) * grid_w) as usize;
+        let Some(cell) = steps.get_mut(i) else { continue };
+        if d < *cell {
+            *cell = d;
+            for (dx, dy) in [(1_i16, 0_i16), (-1, 0), (0, -1), (0, 1)] {
+                let (nx, ny) = (gx.wrapping_add(dx as u16), gy.wrapping_add(dy as u16));
+                if u32::from(nx) < grid_w && u32::from(ny) < grid_h {
+                    let j = (u32::from(ny) * grid_w + u32::from(nx)) as usize;
+                    let there = steps.get(j).copied().unwrap_or(-1);
+                    if there != -1 && d + 1 < there && passable(ox + i32::from(nx), oy + i32::from(ny))
+                    {
+                        queue.push_back((nx, ny, d + 1));
+                    }
+                }
+            }
+        }
+    }
+    let gather = site
+        .gather
+        .unwrap_or_else(|| Point::new(cx - (hx + rx), hy + ry + cy));
+    let (off_x, off_y) = (rx + 0.01, ry + 0.01);
+    let (step_x, step_y) = (rx + rx + 1e-4, ry + ry + 1e-4);
+    let widest = rx.max(ry).max(0.1);
+    let out_rings = (2.0 / (widest + widest)) as i64 as u32;
+    let rings = ((least as f32 / (widest + widest)) as i64 as u32).wrapping_add(out_rings);
+    // 188329 steps 7 and 12: with a tile path of two points or more from the gather point to the
+    // building, the candidates are ordered first by their tiles' steps from the path's last point
+    // but one (0x12796a0)
+    let path = SPAWN_PATH.with(|p| p.borrow().clone());
+    let mut steps2: Option<Vec<i16>> = None;
+    if let (Some(_), Some(points)) = (site.gather, path.as_ref()) {
+        if points.len() > 1 {
+            let (px, py) = points[points.len() - 2];
+            let sx = ((px as i32) - ox).clamp(0, grid_w as i32 - 1);
+            let sy = ((py as i32) - oy).clamp(0, grid_h as i32 - 1);
+            let mut s2 = vec![10000_i16; (grid_w * grid_h) as usize];
+            let mut q: std::collections::VecDeque<(u16, u16, i16)> = std::collections::VecDeque::new();
+            q.push_back((sx as u16, sy as u16, 0));
+            // the game passes the grid coordinates here (0x128a437..58)
+            let mut blocked = !passable(sx, sy);
+            while let Some((gx, gy, d)) = q.pop_front() {
+                let i = (u32::from(gx) + u32::from(gy) * grid_w) as usize;
+                let Some(cell) = s2.get_mut(i) else { continue };
+                if d < *cell {
+                    *cell = d;
+                    for (ddx, ddy) in [(1_i16, 0_i16), (-1, 0), (0, -1), (0, 1)] {
+                        let (nx, ny) = (gx.wrapping_add(ddx as u16), gy.wrapping_add(ddy as u16));
+                        if u32::from(nx) < grid_w && u32::from(ny) < grid_h {
+                            let j = (u32::from(ny) * grid_w + u32::from(nx)) as usize;
+                            let there = s2.get(j).copied().unwrap_or(-1);
+                            if there != -1 && d + 1 < there {
+                                let pass = passable(ox + i32::from(nx), oy + i32::from(ny));
+                                if blocked {
+                                    if pass {
+                                        blocked = false;
+                                    }
+                                    q.push_back((nx, ny, d + 1));
+                                } else if pass {
+                                    q.push_back((nx, ny, d + 1));
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            steps2 = Some(s2);
+        }
+    }
+    let mut n = 0;
+    loop {
+        if n >= rings {
+            // step 13: after the last ring the rings run again by distance alone
+            if steps2.take().is_some() {
+                n = 0;
+                continue;
+            }
+            break;
+        }
+        let ring = n;
+        n += 1;
+        let n = ring;
+        let (dx, dy) = if n < out_rings {
+            (
+                // the offset and the half size are summed first (0x128997e), then the steps
+                step_x * n as f32 + (off_x + hx),
+                n as f32 * step_y + (off_y + hy),
+            )
+        } else {
+            let m = n - out_rings;
+            (
+                (off_x + hx) - m as f32 * step_x,
+                (off_y + hy) - m as f32 * step_y,
+            )
+        };
+        let (lo_x, lo_y, hi_x) = (cx - dx, cy - dy, dx + cx);
+        let mut hi_y = cy + dy;
+        let mut found: Vec<Point> = Vec::new();
+        let mut try_at = |x: f32, y: f32, found: &mut Vec<Point>| -> Result<(), GenieError> {
+            let i = ((y - oyf) as i64 as i32)
+                .wrapping_mul(grid_w as i32)
+                .wrapping_add((x - oxf) as i64 as i32) as u32 as usize;
+            if std::env::var_os("GENIE_TRACE_SPAWN").is_some() {
+                let st = steps.get(i).copied();
+                let free = test(Point::new(x, y))? == Tested::Free;
+                eprintln!("SPAWNCAND ring={n} x={x} y={y} steps={st:?} free={free}");
+            }
+            if steps.get(i).is_some_and(|&d| d < 3)
+                && test(Point::new(x, y))? == Tested::Free
+            {
+                found.push(Point::new(x, y));
+            }
+            Ok(())
+        };
+        let mut x = hi_x;
+        while lo_x + step_x <= x {
+            try_at(x, lo_y, &mut found)?;
+            x -= step_x;
+        }
+        let mut y = lo_y;
+        loop {
+            y += step_y;
+            if !(y <= hi_y) {
+                break;
+            }
+            try_at(hi_x, y, &mut found)?;
+        }
+        let mut x = lo_x;
+        while x <= hi_x - step_x {
+            try_at(x, hi_y, &mut found)?;
+            x += step_x;
+        }
+        loop {
+            hi_y -= step_y;
+            if !(lo_y <= hi_y) {
+                break;
+            }
+            try_at(lo_x, hi_y, &mut found)?;
+        }
+        let key = |p: &Point| {
+            let (fy, fx) = (gather.y() - p.y(), gather.x() - p.x());
+            fy * fy + fx * fx
+        };
+        if let Some(s2) = steps2.as_ref() {
+            let cell = |p: &Point| {
+                let i = ((p.y() - oyf) as i64 as i32)
+                    .wrapping_mul(grid_w as i32)
+                    .wrapping_add((p.x() - oxf) as i64 as i32) as u32 as usize;
+                s2.get(i).copied().unwrap_or(10000)
+            };
+            let mut best: Option<Point> = None;
+            for p in &found {
+                let better = best.is_none_or(|b| {
+                    let (a, bb) = (cell(p), cell(&b));
+                    if a != bb { a < bb } else { key(p) < key(&b) }
+                });
+                if better {
+                    best = Some(*p);
+                }
+            }
+            match best {
+                Some(p) if cell(&p) != 10000 => return Ok(p),
+                _ => continue,
+            }
+        }
+        let mut best: Option<Point> = None;
+        for p in &found {
+            if best.is_none_or(|b| key(p) < key(&b)) {
+                best = Some(*p);
+            }
+        }
+        if let Some(p) = best {
+            return Ok(p);
+        }
+    }
+    Err(GenieError::unsupported(
+        "a spawn point no ring about the building holds",
+    ))
+}
