+    /// Resolve named save players from explicit, fixed lobby civilization choices.
+    /// Random/ambiguous choices are rejected; canonical install metadata is preferred.
+    pub fn resolve_civ_ids_from_lobby(&mut self, count: usize) -> Result<(), Error> {
+        let lobby = self.file_header.game_options_read.game_options.player_info.clone();
+        for (index, p) in self.world.base_world.players.iter_mut().enumerate() {
+            let Some(wp) = p.val.world_player_mut() else { continue };
+            let Some(name) = wp.base.civ_data_name.as_ref() else { continue };
+            if index == 0 && name.bytes == b"GAIA" { wp.base.civ_id = 0; continue; }
+            let choices: Vec<_> = lobby.iter().filter(|p| p.world_player_array_index_including_gaia as usize == index).collect();
+            if choices.len() != 1 { return Err(GenieError::unsupported("ambiguous lobby civilization identity").with("player", index)); }
+            let choice = &choices[0].civilization_choice;
+            let id = choice.specific_civilization_id;
+            if choice.civilization_mode_id != 0 || id <= 0 || id as usize >= count || id > 255 {
+                return Err(GenieError::unsupported("civilization metadata required for non-fixed lobby choice").with("player", index));
+            }
+            wp.base.civ_id = id as u8;
         }
         Ok(())
     }
