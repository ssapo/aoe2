+#[test]
+fn civilization_metadata_validated_and_cache_keyed() {
+    use super::civilization_names;
+    let good = r#"{"civilization_list":[{"data_name":"GAIA"},{"data_name":"FRANKISH-CIV"}]}"#;
+    assert_eq!(civilization_names(good,2).unwrap(),vec!["GAIA","FRANKISH-CIV"]);
+    assert!(civilization_names(good,1).is_err());
+    for bad in [r#"{}"#,r#"{"civilization_list":[{"data_name":""}]}"#,r#"{"civilization_list":[{}]}"#] { assert!(civilization_names(bad,1).is_err()); }
+    assert!(civilization_names(r#"{"civilization_list":[{"data_name":"A"},{"data_name":"A"}]}"#,2).is_err());
+    let before=files(b"dat");let mut after=files(b"dat");after.beside[3]=Some(good.to_owned());
+    assert_ne!(before.key(),after.key());
+    let mut table=MasterTable::default();table.civilization_count=2;
+    let table=with_beside(table, Beside{civilizations:Some(good),..Beside::default()}).unwrap();
+    assert_eq!(crate::cache::decode(&crate::cache::encode(&table).unwrap()).unwrap(),table);
+}
