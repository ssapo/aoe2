+/// Validate names before caching: no missing/duplicate/blank identities or count mismatch.
+pub fn civilization_names(text: &str, count: usize) -> Result<Vec<String>, GenieError> {
+    let value: Value = serde_json::from_str(text).map_err(|e| out_of_shape("civilizations.json", e))?;
+    let invalid = || GenieError::invalid_input("invalid civilization name list").with("file", "civilizations.json");
+    let list = value.get("civilization_list").and_then(Value::as_array).ok_or_else(invalid)?;
+    if list.len() != count || count > 256 { return Err(invalid()); }
+    let mut names = Vec::with_capacity(count);
+    let mut seen = std::collections::BTreeSet::new();
+    for item in list {
+        let name = item.get("data_name").and_then(Value::as_str).ok_or_else(invalid)?;
+        if name.is_empty() || name.trim() != name || !seen.insert(name.to_owned()) { return Err(invalid()); }
+        names.push(name.to_owned());
+    }
+    Ok(names)
 }
 
