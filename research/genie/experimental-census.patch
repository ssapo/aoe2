+    /// [`Player::world_player`], mutably (to resolve a save 68.9 civilization name).
+    pub fn world_player_mut(&mut self) -> Option<&mut WorldPlayer> {
+        if let Some(p) = self.scenario_editor_phantom_player.as_deref_mut() {
+            return Some(&mut p.world_player_scenario_editor_phantom);
+        }
+        if let Some(p) = self.human_or_coop_player.as_deref_mut() {
+            return Some(&mut p.world_player_human_or_coop);
+        }
+        if let Some(p) = self.gaia_player.as_deref_mut() {
+            return Some(&mut p.world_player_gaia.world_player);
+        }
+        self.computer_player
+            .as_deref_mut()
+            .map(|p| &mut p.world_player_computer)
+    }
