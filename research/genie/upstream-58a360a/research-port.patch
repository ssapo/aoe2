+/// EXPERIMENT (save 68.9 data): the tasks of types 154, 155 and 157, which the task finder's
+/// general search leaves out, hold a class below -1 (-1288, -1256, -1448) whose meaning is
+/// unknown. The value is kept as is (no object's class is negative, so no class match picks the
+/// task) instead of being rejected or turned into "any class". Not verified against the game.
+fn special_group(action_kind: i16, class_id: i16) -> Option<ClassId> {
+    (class_id < -1 && matches!(action_kind, 154 | 155 | 157)).then(|| ClassId::of_master(class_id))
+}
