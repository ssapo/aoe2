+    /// A name `data_names` does not hold, or an index above 255.
+    pub fn resolve_civ_ids(&mut self, data_names: &[String]) -> GenieResult<()> {
+        for p in &mut self.world.base_world.players {
+            let Some(wp) = p.val.world_player_mut() else { continue };
+            let Some(name) = wp.base.civ_data_name.as_ref() else { continue };
+            let name = String::from_utf8_lossy(&name.bytes).into_owned();
+            let index = data_names.iter().position(|n| *n == name).ok_or_else(|| {
+                GenieError::invalid_input("a civilization name civilizations.json does not hold")
+                    .with("name", &name)
+            })?;
+            wp.base.civ_id = u8::try_from(index).map_err(|_| {
+                GenieError::invalid_input("a civilization index above 255").with("index", index)
+            })?;
+        }
