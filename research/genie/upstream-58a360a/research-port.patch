@@ -0,0 +1,53 @@
+//! Experimental observer. It never writes to the simulated world.
+use std::collections::{BTreeMap, BTreeSet};
+use genie_core::world::World;
+use genie_core::players::PlayerId;
+
+#[derive(Clone, Copy)]
+struct Seen { player: usize, master: i16, class: i16, state: u8 }
+#[derive(Default)]
+pub(super) struct Observer { previous: BTreeMap<i32, Seen>, counted: BTreeSet<i32>, stopped: BTreeSet<usize> }
+fn deaths(before: u8, after: u8) -> bool { before == 2 && (3..=5).contains(&after) }
+impl Observer {
+    pub(super) fn observe(&mut self, w: &World, emit: bool) {
+        let ms = w.world_time.millis();
+        let mut current = BTreeMap::new();
+        for (p, player) in w.players.iter().enumerate() {
+            if player.unsupported.is_some() && self.stopped.insert(p) {
+                eprintln!("DEATH_STOP ms={ms} player={p}");
+            }
+            for u in &player.objects {
+                let Ok(m) = u.master(w.master_tables(), PlayerId::new(u8::try_from(p).expect("player slot fits u8"))) else { continue };
+                // Creatable units only; no buildings, missiles, livestock, or scenery.
+                if m.kind.get() != 70 || m.class.get() == 58 { continue }
+                let now = Seen { player: p, master: u.life.master_id.get(), class: m.class.get(), state: u.life.state.get() };
+                current.insert(u.id.get(), now);
+                if !emit { continue }
+                if let Some(old) = self.previous.get(&u.id.get()) {
+                    if old.player != p {
+                        eprintln!("DEATH_OWNER ms={ms} id={} from={} to={p}",u.id.get(),old.player);
+                    }
+                    if old.player > 0 && deaths(old.state, now.state) && self.counted.insert(u.id.get()) {
+                        eprintln!("DEATH_EVENT ms={ms} player={} id={} master={} class={} degraded={}", old.player,u.id.get(),old.master,old.class,!self.stopped.is_empty());
+                    }
+                }
+            }
+        }
+        if emit {
+            for (id,old) in &self.previous {
+                if old.player > 0 && old.state == 2 && !current.contains_key(id) && !self.counted.contains(id) {
+                    eprintln!("DEATH_UNRESOLVED ms={ms} player={} id={} master={}",old.player,id,old.master);
+                }
+            }
+        }
+        self.previous = current;
+    }
+}
+#[cfg(test)]
