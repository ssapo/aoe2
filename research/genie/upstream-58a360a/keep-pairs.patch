+impl Ids {
+    /// Preserve an established recorded ID even if the simulator later allocates its raw
+    /// number to something else. Some(None) means the paired object is no longer ours.
+    fn kept_unit(&self, recorded: ObjectId, owns: impl Fn(ObjectId) -> bool) -> Option<Option<ObjectId>> {
+        self.map.get(&recorded.get()).map(|&to| ObjectId::of_field(to).filter(|&id| owns(id)))
+    }
 }
 
