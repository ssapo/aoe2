+#[cfg(test)]
+mod pair_tests {
+    use super::*;
+    #[test]
+    fn kept_pair_wins_when_raw_id_later_exists() {
+        let mut ids = Ids::default();
+        let _ = ids.map.insert(4401, 4399);
+        assert_eq!(ids.kept_unit(ObjectId::of_field(4401).unwrap(), |id| [4399, 4401].contains(&id.get())), Some(ObjectId::of_field(4399)));
+    }
+    #[test]
+    fn gone_pair_does_not_fall_back_to_same_number_object() {
+        let mut ids = Ids::default();
+        let _ = ids.map.insert(4401, 4399);
+        assert_eq!(ids.kept_unit(ObjectId::of_field(4401).unwrap(), |id| id.get() == 4401), Some(None));
+        assert_eq!(ids.kept_unit(ObjectId::of_field(4402).unwrap(), |_| true), None);
+    }
