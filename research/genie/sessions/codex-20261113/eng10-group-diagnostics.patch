diff --git a/crates/tools/genie-oracle/src/census/movement_trace.rs b/crates/tools/genie-oracle/src/census/movement_trace.rs
new file mode 100644
--- /dev/null
+++ b/crates/tools/genie-oracle/src/census/movement_trace.rs
@@ -0,0 +1,161 @@
+//! Read-only movement snapshots for the opt-in OBJECT trace, after a world update.
+
+use genie_core::groups::UnitGroup;
+use genie_core::objects::{ObjectId, unit::Unit};
+use genie_core::players::PlayerId;
+use genie_core::world::World;
+use serde_json::{Value, json};
+
+/// Keep the unit's link even when its group is absent from the world's group list.
+pub(super) fn snapshot(world: &World, unit: &Unit, player: PlayerId) -> Value {
+    let master_base = unit
+        .master(world.master_tables(), player)
+        .ok()
+        .and_then(|master| master.move_stats.as_ref())
+        .map(|stats| stats.base.get());
+    let movement = world.parts.mover_of(unit.id).map(|mover| {
+        json!({
+            "base_speed": mover.stats.base.get(),
+            "speed": mover.stats.speed.get(),
+            "master_base_speed": master_base,
+            "velocity_local_xhy": mover.velocity.map(|v| v.velocity.get()),
+            "forward_xhy": mover.forward.get(),
+            "path_count": mover.paths.len(),
+            "waiting": mover.waiting,
+            "last_move_ms": mover.last_move.millis(),
+        })
+    });
+    json!({
+        "phase": "post_update",
+        "movement": movement,
+        "group": {
+            "id": unit.group.id.map(|id| id.get()),
+            "flag": unit.group.flag,
+            "snapshot": unit.group.id.and_then(|id| world.groups.get(id))
+                .map(|group| group_snapshot(group, unit.id)),
+        },
+    })
+}
+
+/// Look up the speed by member ID; formation slot order can differ from member order.
+fn group_snapshot(group: &UnitGroup, id: ObjectId) -> Value {
+    let member_index = group.members.iter().position(|member| member.id == id);
+    let member = member_index.and_then(|index| group.members.get(index));
+    let speed = member_index
+        .and_then(|index| group.forming_speeds.get(index))
+        .copied()
+        .flatten();
+    let slot = group.current_formation.as_ref().and_then(|formation| {
+        formation
+            .slots
+            .iter()
+            .enumerate()
+            .find(|(_, slot)| slot.unit_id == Some(id))
+            .map(|(index, slot)| {
+                json!({
+                    "index": index,
+                    "position": slot.transform_position.position().get(),
+                    "desired_position": slot.desired_transform_position.position().get(),
+                    "state": slot.state.get(),
+                    "active": slot.active,
+                    "depth": slot.depth,
+                })
+            })
+    });
+    json!({
+        "member_ids": group.members.iter().map(|member| member.id.get()).collect::<Vec<_>>(),
+        "member_index": member_index,
+        "forming_speed": speed,
+        "specific_move_active": member.map(|member| member.specific_move.active),
+        "formed": group.formed,
+        "first_pass": group.first_pass,
+        "speed_budget": group.speed_budget,
+        "slowest_speed": group.slowest_speed,
+        "maximum_velocity_forward": group.motion.maximum_velocity_forward.get(),
+        "position": group.motion.position[0].position().get(),
+        "velocity_local_xhy": group.motion.velocity.get(),
+        "slot": slot,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use genie_core::groups::{Formation, Member, Slot};
+    use genie_core::math::fmath::BVector;
+
+    fn id(value: i32) -> ObjectId {
+        ObjectId::try_from(value).unwrap()
+    }
+
+    #[test]
+    fn member_order_and_slot_order_are_independent_and_positions_use_xyz() {
+        let group = UnitGroup {
+            members: vec![
+                Member {
+                    id: id(41),
+                    ..Member::default()
+                },
+                Member {
+                    id: id(17),
+                    ..Member::default()
+                },
+            ],
+            forming_speeds: vec![Some(0.9), Some(1.2)],
+            current_formation: Some(Formation {
+                slots: vec![
+                    Slot {
+                        unit_id: Some(id(17)),
+                        transform_position: BVector::new(10.0, 2.0, 30.0),
+                        ..Slot::default()
+                    },
+                    Slot {
+                        unit_id: Some(id(41)),
+                        ..Slot::default()
+                    },
+                ],
+                ..Formation::default()
+            }),
+            ..UnitGroup::default()
+        };
+        let row = group_snapshot(&group, id(17));
+        assert_eq!(row["member_index"], 1);
+        assert_eq!(row["forming_speed"], json!(1.2_f32));
+        assert_eq!(row["slot"]["index"], 0);
+        assert_eq!(row["slot"]["position"], json!([10.0, 30.0, 2.0]));
+    }
+
+    #[test]
+    fn missing_member_or_speed_is_null_instead_of_borrowing_another_members_speed() {
+        let mut group = UnitGroup {
+            members: vec![Member {
+                id: id(17),
+                ..Member::default()
+            }],
+            ..UnitGroup::default()
+        };
+        let row = group_snapshot(&group, id(17));
+        assert!(row["forming_speed"].is_null());
+        assert!(row["slot"].is_null());
+        group.forming_speeds = vec![Some(1.2)];
+        let absent = group_snapshot(&group, id(99));
+        assert!(absent["member_index"].is_null());
+        assert!(absent["forming_speed"].is_null());
+        assert!(absent["specific_move_active"].is_null());
+    }
+
+    #[test]
+    fn a_missing_group_keeps_the_units_link_for_diagnosis() {
+        use crate::fixtures::{combat_object, gaia, header, human};
+        use genie_core::groups::GroupId;
+
+        let save = header(vec![gaia(Vec::new()), human(vec![combat_object(17, 83)])]);
+        let mut world = crate::header_slice(&save, None).unwrap();
+        world.players[1].objects.iter_mut().next().unwrap().group.id = GroupId::of_field(999);
+        let unit = world.players[1].objects.iter().next().unwrap();
+        let row = snapshot(&world, unit, PlayerId::new(1));
+        assert_eq!(row["group"]["id"], 999);
+        assert!(row["group"]["snapshot"].is_null());
+        assert_eq!(row["phase"], "post_update");
+    }
+}
